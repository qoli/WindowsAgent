<Window
    x:Class="WindowsAgent.AssistGui.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    Title="WindowsAgent Assist">

  <Window.SystemBackdrop>
    <MicaBackdrop />
  </Window.SystemBackdrop>

  <Grid x:Name="Root">
    <Grid.Resources>
      <x:Double x:Key="SettingsCardSpacing">4</x:Double>
      <x:Double x:Key="Breakpoint640Plus">641</x:Double>

      <Style x:Key="SettingsSectionHeaderTextBlockStyle"
             BasedOn="{StaticResource BodyStrongTextBlockStyle}"
             TargetType="TextBlock">
        <Setter Property="Margin" Value="1,30,0,6" />
      </Style>
    </Grid.Resources>

    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <TitleBar x:Name="AppTitleBar" Title="WindowsAgent Assist">
      <TitleBar.IconSource>
        <FontIconSource Glyph="&#xE90F;" />
      </TitleBar.IconSource>
    </TitleBar>

    <Grid Grid.Row="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid x:Name="PageHeaderGrid"
            MaxWidth="760"
            Margin="36,24,36,0"
            ColumnSpacing="16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Spacing="4">
          <TextBlock Text="Set up WindowsAgent"
                     AutomationProperties.HeadingLevel="Level1"
                     Style="{StaticResource TitleTextBlockStyle}" />
          <TextBlock Text="Install and manage WindowsAgent on this PC."
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                     Style="{StaticResource BodyTextBlockStyle}" />
        </StackPanel>

        <Button x:Name="RefreshButton"
                Grid.Column="1"
                VerticalAlignment="Top"
                AutomationProperties.Name="Refresh WindowsAgent status"
                Click="RefreshButton_Click"
                ToolTipService.ToolTip="Refresh status">
          <FontIcon Glyph="&#xE72C;" />
        </Button>
      </Grid>

      <ScrollView x:Name="PageScroll"
                  Grid.Row="1"
                  Padding="36,0,36,0"
                  VerticalScrollBarVisibility="Auto"
                  VerticalScrollMode="Auto">
        <StackPanel MaxWidth="760" Spacing="{StaticResource SettingsCardSpacing}">
          <InfoBar x:Name="NoticeBar"
                   Margin="0,24,0,0"
                   IsOpen="False"
                   IsClosable="True" />

          <TextBlock Text="WindowsAgent"
                     AutomationProperties.HeadingLevel="Level2"
                     Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

          <toolkit:SettingsCard Header="Installation"
                                Description="WindowsAgent runtime on this PC">
            <toolkit:SettingsCard.HeaderIcon>
              <FontIcon Glyph="&#xE896;" />
            </toolkit:SettingsCard.HeaderIcon>
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock x:Name="InstalledValue"
                         VerticalAlignment="Center"
                         FontWeight="SemiBold"
                         Text="Checking…" />
              <Button x:Name="InstallButton"
                      Content="Install WindowsAgent"
                      Style="{StaticResource AccentButtonStyle}"
                      Click="InstallButton_Click"
                      Visibility="Collapsed" />
            </StackPanel>
          </toolkit:SettingsCard>

          <toolkit:SettingsCard x:Name="VersionCard"
                                Header="Version"
                                Description="Installed WindowsAgent release"
                                Visibility="Collapsed">
            <toolkit:SettingsCard.HeaderIcon>
              <FontIcon Glyph="&#xE946;" />
            </toolkit:SettingsCard.HeaderIcon>
            <TextBlock x:Name="VersionValue" Text="—" IsTextSelectionEnabled="True" />
          </toolkit:SettingsCard>

          <toolkit:SettingsCard x:Name="CaptureCard"
                                Header="Capture Agent"
                                Description="Interactive WindowsAgent process"
                                Visibility="Collapsed">
            <toolkit:SettingsCard.HeaderIcon>
              <FontIcon Glyph="&#xE722;" />
            </toolkit:SettingsCard.HeaderIcon>
            <TextBlock x:Name="CaptureValue" Text="—" FontWeight="SemiBold" />
          </toolkit:SettingsCard>

          <toolkit:SettingsCard x:Name="WatchdogCard"
                                Header="Watchdog"
                                Description="Owns the installed runtime process lifecycle"
                                Visibility="Collapsed">
            <toolkit:SettingsCard.HeaderIcon>
              <FontIcon Glyph="&#xEA18;" />
            </toolkit:SettingsCard.HeaderIcon>
            <TextBlock x:Name="WatchdogValue" Text="—" FontWeight="SemiBold" />
          </toolkit:SettingsCard>

          <toolkit:SettingsCard Header="Start at sign-in"
                                Description="Automatically start WindowsAgent after this user signs in">
            <toolkit:SettingsCard.HeaderIcon>
              <FontIcon Glyph="&#xE7E8;" />
            </toolkit:SettingsCard.HeaderIcon>
            <ToggleSwitch x:Name="StartAtSignInToggle"
                          IsOn="True"
                          Toggled="StartAtSignInToggle_Toggled" />
          </toolkit:SettingsCard>

          <toolkit:SettingsCard x:Name="RuntimeActionCard"
                                Header="Runtime processes"
                                Description="Start or stop the installed WindowsAgent processes"
                                Visibility="Collapsed">
            <toolkit:SettingsCard.HeaderIcon>
              <FontIcon Glyph="&#xE768;" />
            </toolkit:SettingsCard.HeaderIcon>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button x:Name="StartButton"
                      Content="Start WindowsAgent"
                      Style="{StaticResource AccentButtonStyle}"
                      Click="StartButton_Click"
                      Visibility="Collapsed" />
              <Button x:Name="StopButton"
                      Content="Stop WindowsAgent"
                      Click="StopButton_Click"
                      Visibility="Collapsed" />
            </StackPanel>
          </toolkit:SettingsCard>

          <TextBlock Text="Access"
                     AutomationProperties.HeadingLevel="Level2"
                     Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

          <toolkit:SettingsCard Header="LAN endpoint"
                                Description="Private-network addresses for this PC">
            <toolkit:SettingsCard.HeaderIcon>
              <FontIcon Glyph="&#xE968;" />
            </toolkit:SettingsCard.HeaderIcon>
            <TextBlock x:Name="LanEndpointsValue"
                       MaxWidth="320"
                       Text="None detected"
                       TextWrapping="Wrap"
                       IsTextSelectionEnabled="True" />
          </toolkit:SettingsCard>

          <toolkit:SettingsCard Header="Tailscale"
                                Description="Private tailnet access and assigned addresses">
            <toolkit:SettingsCard.HeaderIcon>
              <FontIcon Glyph="&#xE71B;" />
            </toolkit:SettingsCard.HeaderIcon>
            <StackPanel MaxWidth="320" Spacing="4">
              <TextBlock x:Name="TailscaleStatusValue" Text="—" FontWeight="SemiBold" />
              <TextBlock x:Name="TailscaleAddressesValue"
                         Text="No Tailscale addresses"
                         TextWrapping="Wrap"
                         IsTextSelectionEnabled="True" />
              <Button x:Name="DisconnectTailscaleButton"
                      Margin="0,4,0,0"
                      HorizontalAlignment="Left"
                      Content="Disconnect"
                      Click="DisconnectTailscaleButton_Click"
                      Visibility="Collapsed" />
            </StackPanel>
          </toolkit:SettingsCard>

          <toolkit:SettingsCard x:Name="TailscaleConnectCard"
                                Header="Connect Tailscale"
                                Description="Enter a one-off auth key to start Tailscale access"
                                Visibility="Collapsed">
            <toolkit:SettingsCard.HeaderIcon>
              <FontIcon Glyph="&#xE8FA;" />
            </toolkit:SettingsCard.HeaderIcon>
            <StackPanel MaxWidth="320" Spacing="8">
              <PasswordBox x:Name="AuthKeyBox"
                           MinWidth="280"
                           PlaceholderText="One-off auth key"
                           PasswordChanged="AuthKeyBox_PasswordChanged" />
              <Button x:Name="ConnectTailscaleButton"
                      HorizontalAlignment="Left"
                      Content="Connect"
                      Click="ConnectTailscaleButton_Click" />
            </StackPanel>
          </toolkit:SettingsCard>

          <TextBlock x:Name="MaintenanceSectionHeader"
                     Text="Maintenance"
                     AutomationProperties.HeadingLevel="Level2"
                     Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                     Visibility="Collapsed" />

          <toolkit:SettingsCard x:Name="UpdateCard"
                                Header="Update WindowsAgent"
                                Description="Download and install the latest public release"
                                Visibility="Collapsed">
            <toolkit:SettingsCard.HeaderIcon>
              <FontIcon Glyph="&#xE895;" />
            </toolkit:SettingsCard.HeaderIcon>
            <Button x:Name="UpdateButton" Content="Update" Click="UpdateButton_Click" />
          </toolkit:SettingsCard>

          <toolkit:SettingsCard x:Name="RepairCard"
                                Header="Repair installation"
                                Description="Reinstall required files and owned Scheduled Tasks"
                                Visibility="Collapsed">
            <toolkit:SettingsCard.HeaderIcon>
              <FontIcon Glyph="&#xE90F;" />
            </toolkit:SettingsCard.HeaderIcon>
            <Button x:Name="RepairButton" Content="Repair" Click="RepairButton_Click" />
          </toolkit:SettingsCard>

          <toolkit:SettingsCard x:Name="UninstallCard"
                                Header="Uninstall WindowsAgent"
                                Description="Remove the runtime and its owned Scheduled Tasks"
                                Visibility="Collapsed">
            <toolkit:SettingsCard.HeaderIcon>
              <FontIcon Glyph="&#xE74D;" />
            </toolkit:SettingsCard.HeaderIcon>
            <Button x:Name="UninstallButton" Content="Uninstall" Click="UninstallButton_Click" />
          </toolkit:SettingsCard>

          <TextBlock x:Name="OperationSectionHeader"
                     Text="Operation"
                     AutomationProperties.HeadingLevel="Level2"
                     Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                     Visibility="Collapsed" />

          <Border x:Name="OperationPanel"
                  Margin="0,0,0,36"
                  Padding="16"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  CornerRadius="8"
                  Visibility="Collapsed">
            <StackPanel Spacing="12">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <ProgressRing x:Name="OperationProgress"
                              Width="20"
                              Height="20"
                              IsActive="False" />
                <TextBlock x:Name="OperationTitle"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold" />
              </StackPanel>
              <ItemsControl x:Name="ProgressItems" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollView>

      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="LayoutVisualStates">
          <VisualState x:Name="StandardLayout">
            <VisualState.StateTriggers>
              <AdaptiveTrigger MinWindowWidth="{StaticResource Breakpoint640Plus}" />
            </VisualState.StateTriggers>
          </VisualState>
          <VisualState x:Name="NarrowLayout">
            <VisualState.StateTriggers>
              <AdaptiveTrigger MinWindowWidth="0" />
            </VisualState.StateTriggers>
            <VisualState.Setters>
              <Setter Target="PageHeaderGrid.Margin" Value="24,24,16,0" />
              <Setter Target="PageScroll.Padding" Value="16,0,16,0" />
              <Setter Target="AuthKeyBox.MinWidth" Value="220" />
            </VisualState.Setters>
          </VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
    </Grid>
  </Grid>
</Window>
