<Window
    x:Class="WindowsAgent.AssistGui.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WindowsAgent Assist">

  <Window.SystemBackdrop>
    <MicaBackdrop />
  </Window.SystemBackdrop>

  <Grid x:Name="Root">
    <Grid.Resources>
      <x:Double x:Key="Breakpoint640Plus">641</x:Double>

      <Style x:Key="SectionHeaderTextBlockStyle"
             BasedOn="{StaticResource BodyStrongTextBlockStyle}"
             TargetType="TextBlock">
        <Setter Property="Margin" Value="1,24,0,6" />
      </Style>

      <Style x:Key="GroupedCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
      </Style>

      <Style x:Key="SettingsRowStyle" TargetType="Grid">
        <Setter Property="MinHeight" Value="64" />
        <Setter Property="Padding" Value="16,10" />
      </Style>

      <Style x:Key="RowLabelTextBlockStyle"
             BasedOn="{StaticResource BodyStrongTextBlockStyle}"
             TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
    </Grid.Resources>

    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <TitleBar x:Name="AppTitleBar" Title="WindowsAgent Assist">
      <TitleBar.IconSource>
        <FontIconSource Glyph="&#xE90F;" />
      </TitleBar.IconSource>
    </TitleBar>

    <ScrollView x:Name="PageScroll"
                Grid.Row="1"
                Padding="36,0,36,28"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Auto">
      <StackPanel MaxWidth="640">
        <InfoBar x:Name="NoticeBar"
                 Margin="0,20,0,0"
                 IsOpen="False"
                 IsClosable="True" />

        <TextBlock Text="Maintenance"
                   AutomationProperties.HeadingLevel="Level1"
                   Style="{StaticResource SectionHeaderTextBlockStyle}" />

        <Border Style="{StaticResource GroupedCardStyle}">
          <StackPanel>
            <Grid Style="{StaticResource SettingsRowStyle}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Maintenance" Style="{StaticResource RowLabelTextBlockStyle}" />
              <Button x:Name="InstallButton"
                      Grid.Column="1"
                      Content="Install"
                      Style="{StaticResource AccentButtonStyle}"
                      Click="InstallButton_Click"
                      Visibility="Collapsed" />
              <Button x:Name="MaintenanceButton"
                      Grid.Column="1"
                      AutomationProperties.Name="Maintenance actions"
                      Visibility="Collapsed">
                <FontIcon Glyph="&#xE70D;" />
                <Button.Flyout>
                  <MenuFlyout>
                    <MenuFlyoutItem x:Name="UpdateMenuItem"
                                    Text="Update"
                                    Click="UpdateMenuItem_Click" />
                    <MenuFlyoutItem x:Name="ReinstallMenuItem"
                                    Text="Reinstall"
                                    Click="ReinstallMenuItem_Click" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Name="UninstallMenuItem"
                                    Text="Uninstall"
                                    Click="UninstallMenuItem_Click" />
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
            </Grid>

            <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

            <Grid Style="{StaticResource SettingsRowStyle}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Version" Style="{StaticResource RowLabelTextBlockStyle}" />
              <TextBlock x:Name="VersionValue"
                         Grid.Column="1"
                         VerticalAlignment="Center"
                         Text="—"
                         IsTextSelectionEnabled="True" />
            </Grid>
          </StackPanel>
        </Border>

        <Grid Margin="1,24,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Status"
                     VerticalAlignment="Center"
                     AutomationProperties.HeadingLevel="Level1"
                     Style="{StaticResource BodyStrongTextBlockStyle}" />
          <Button x:Name="RefreshButton"
                  Grid.Column="1"
                  MinWidth="0"
                  MinHeight="0"
                  Padding="8,4"
                  AutomationProperties.Name="Refresh WindowsAgent status"
                  Click="RefreshButton_Click"
                  ToolTipService.ToolTip="Refresh status">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <FontIcon Glyph="&#xE72C;" FontSize="14" />
              <TextBlock Text="Refresh" />
            </StackPanel>
          </Button>
        </Grid>

        <Border Style="{StaticResource GroupedCardStyle}">
          <StackPanel>
            <Grid Style="{StaticResource SettingsRowStyle}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="WindowsAgent" Style="{StaticResource RowLabelTextBlockStyle}" />
              <Button x:Name="RuntimeMenuButton"
                      Grid.Column="1"
                      IsEnabled="False">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock x:Name="RuntimeStatusValue"
                             VerticalAlignment="Center"
                             Text="Checking…" />
                  <FontIcon Glyph="&#xE70D;" FontSize="12" />
                </StackPanel>
                <Button.Flyout>
                  <MenuFlyout>
                    <MenuFlyoutItem x:Name="StartRuntimeMenuItem"
                                    Text="Start"
                                    Click="StartRuntimeMenuItem_Click"
                                    Visibility="Collapsed" />
                    <MenuFlyoutItem x:Name="StopRuntimeMenuItem"
                                    Text="Stop"
                                    Click="StopRuntimeMenuItem_Click"
                                    Visibility="Collapsed" />
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
            </Grid>

            <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

            <Grid Style="{StaticResource SettingsRowStyle}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Starts at sign-in" Style="{StaticResource RowLabelTextBlockStyle}" />
              <CheckBox x:Name="StartAtSignInCheckBox"
                        Grid.Column="1"
                        MinWidth="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        IsChecked="True"
                        Click="StartAtSignInCheckBox_Click" />
            </Grid>
          </StackPanel>
        </Border>

        <TextBlock Text="Access"
                   AutomationProperties.HeadingLevel="Level1"
                   Style="{StaticResource SectionHeaderTextBlockStyle}" />

        <Border Style="{StaticResource GroupedCardStyle}">
          <StackPanel>
            <Grid Style="{StaticResource SettingsRowStyle}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="LAN" Style="{StaticResource RowLabelTextBlockStyle}" />
              <TextBlock x:Name="LanEndpointsValue"
                         Grid.Column="1"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center"
                         MaxWidth="400"
                         Text="None detected"
                         TextWrapping="Wrap"
                         IsTextSelectionEnabled="True" />
            </Grid>

            <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

            <Grid MinHeight="96" Padding="16,12" ColumnSpacing="16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="Tailscale"
                         VerticalAlignment="Top"
                         Margin="0,8,0,0"
                         Style="{StaticResource RowLabelTextBlockStyle}" />
              <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="6">
                <Grid x:Name="TailscaleDisconnectedPanel" Visibility="Collapsed">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <PasswordBox x:Name="AuthKeyBox"
                               MinWidth="220"
                               PlaceholderText="Tailscale auth key"
                               PasswordChanged="AuthKeyBox_PasswordChanged" />
                  <Button x:Name="ConnectTailscaleButton"
                          Grid.Column="1"
                          Margin="8,0,0,0"
                          Content="Connect"
                          Click="ConnectTailscaleButton_Click" />
                </Grid>
                <StackPanel x:Name="TailscaleConnectedPanel"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Spacing="12"
                            Visibility="Collapsed">
                  <Button x:Name="DisconnectTailscaleButton"
                          Content="Disconnect"
                          Click="DisconnectTailscaleButton_Click" />
                </StackPanel>
                <TextBlock x:Name="TailscaleStatusValue"
                           HorizontalAlignment="Right"
                           FontWeight="SemiBold"
                           Text="—" />
                <TextBlock x:Name="TailscaleAddressesValue"
                           HorizontalAlignment="Right"
                           MaxWidth="400"
                           Text="No Tailscale addresses"
                           TextAlignment="Right"
                           TextWrapping="Wrap"
                           IsTextSelectionEnabled="True" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollView>

    <Grid x:Name="OperationOverlay"
          Grid.RowSpan="2"
          Canvas.ZIndex="100"
          Padding="24"
          Background="{ThemeResource SmokeFillColorDefaultBrush}"
          Visibility="Collapsed">
      <Border MaxWidth="520"
              MinWidth="360"
              MaxHeight="440"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Padding="24"
              Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
              BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
              BorderThickness="1"
              CornerRadius="8">
        <StackPanel Spacing="16">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <ProgressRing x:Name="OperationProgress"
                          Width="24"
                          Height="24"
                          IsActive="False" />
            <TextBlock x:Name="OperationTitle"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Style="{StaticResource SubtitleTextBlockStyle}" />
          </StackPanel>
          <ScrollView MaxHeight="300"
                      VerticalScrollBarVisibility="Auto"
                      VerticalScrollMode="Auto">
            <ItemsControl x:Name="ProgressItems" />
          </ScrollView>
        </StackPanel>
      </Border>
    </Grid>

    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="LayoutVisualStates">
        <VisualState x:Name="StandardLayout">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="{StaticResource Breakpoint640Plus}" />
          </VisualState.StateTriggers>
        </VisualState>
        <VisualState x:Name="NarrowLayout">
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="0" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="PageScroll.Padding" Value="16,0,16,20" />
            <Setter Target="AuthKeyBox.MinWidth" Value="160" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
  </Grid>
</Window>
