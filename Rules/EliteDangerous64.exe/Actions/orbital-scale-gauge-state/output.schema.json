{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "gauge", "evidence"],
  "properties": {
    "schemaVersion": {"const": 2},
    "gauge": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "confidence", "threshold", "reason"],
      "properties": {
        "state": {"enum": ["DETECTED", "ABSENT"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "threshold": {"const": 0.75},
        "reason": {"enum": ["ORBITAL_VERTICAL_SCALE_GEOMETRY_CONFIRMED", "ORBITAL_VERTICAL_SCALE_GEOMETRY_NOT_CONFIRMED"]}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["capturedAt", "referenceRegion", "algorithm", "orangePixelCount", "spineX", "spinePixelCount", "spineSpanPixels", "tickCount", "tickSpreadPixels"],
      "properties": {
        "capturedAt": {"type": "string", "minLength": 1},
        "referenceRegion": {"type": "object"},
        "algorithm": {"const": "HSV_ORANGE_ORBITAL_VERTICAL_SCALE_GEOMETRY_V2"},
        "orangePixelCount": {"type": "integer", "minimum": 0},
        "spineX": {"type": "integer", "minimum": 1120, "maximum": 1264},
        "spinePixelCount": {"type": "integer", "minimum": 0},
        "spineSpanPixels": {"type": "integer", "minimum": 0},
        "tickCount": {"type": "integer", "minimum": 0},
        "tickSpreadPixels": {"type": "integer", "minimum": 0}
      }
    }
  }
}
