{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "cockpitHud", "profile", "region"],
  "properties": {
    "schemaVersion": {"const": 1},
    "cockpitHud": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "orangePixelCount", "chargeCyanPixelCount", "hudPixelCount", "minimumHudPixels"],
      "properties": {
        "state": {"enum": ["PRESENT", "ABSENT"]},
        "orangePixelCount": {"type": "integer", "minimum": 0, "maximum": 14400},
        "chargeCyanPixelCount": {"type": "integer", "minimum": 0, "maximum": 14400},
        "hudPixelCount": {"type": "integer", "minimum": 0, "maximum": 14400},
        "minimumHudPixels": {"const": 250}
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "capturedAt"],
      "properties": {
        "width": {"type": "integer", "minimum": 1, "maximum": 16384},
        "height": {"type": "integer", "minimum": 1, "maximum": 16384},
        "capturedAt": {"type": "string", "format": "date-time", "maxLength": 64}
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "w", "h"],
      "properties": {"x": {"const": 1280}, "y": {"const": 790}, "w": {"const": 120}, "h": {"const": 120}}
    }
  }
}
