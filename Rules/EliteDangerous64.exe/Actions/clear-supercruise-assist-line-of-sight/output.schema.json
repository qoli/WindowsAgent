{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "task", "completed", "targetName", "control", "turnPulses", "bypassFlightSamples", "finalFlightStatus", "sampleCount"],
  "properties": {
    "schemaVersion": {"const": 1},
    "task": {"const": "CLEAR_SUPERCRUISE_ASSIST_LINE_OF_SIGHT"},
    "completed": {"const": true},
    "targetName": {"type": "string", "minLength": 2, "maxLength": 96},
    "control": {"enum": ["PITCH_UP", "PITCH_DOWN", "YAW_LEFT", "YAW_RIGHT", "PITCH_UP_YAW_LEFT", "PITCH_UP_YAW_RIGHT", "PITCH_DOWN_YAW_LEFT", "PITCH_DOWN_YAW_RIGHT"]},
    "turnPulses": {"type": "integer", "minimum": 1, "maximum": 16},
    "bypassFlightSamples": {"type": "integer", "minimum": 0, "maximum": 120},
    "finalFlightStatus": {"enum": ["UNKNOWN", "SUPERCRUISE", "SUPERCRUISE_ASSIST_ACTIVE", "FSD_ALIGNMENT_REQUIRED", "SAFE_DISENGAGE_READY"]},
    "sampleCount": {"type": "integer", "minimum": 4, "maximum": 160}
  }
}
