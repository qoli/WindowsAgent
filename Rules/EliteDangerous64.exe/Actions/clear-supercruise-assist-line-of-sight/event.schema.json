{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "payload"],
  "properties": {
    "type": {"const": "action.clear-supercruise-assist-line-of-sight.update"},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "sample", "targetName", "flightStatus", "flightPromptText", "sphereState", "sphereCenterX", "sphereCenterY", "sphereRadiusPixels", "signedLimbClearancePixels", "sphereConfidencePermille", "directionState", "control", "turnPulses", "noProgressPulses", "absentConfirmations", "separationSamples", "clearConfirmations", "commandedThrottle", "lastCommand", "reason"],
      "properties": {
        "phase": {"enum": ["CONFIRMING_GATE", "STOPPING_DIRECT_APPROACH", "SELECTING_OUTWARD_DIRECTION", "TURNING_OUTWARD", "VERIFYING_SPHERE_EXIT", "SEPARATION_FLIGHT", "VERIFYING_PROMPT_CLEAR", "COMPLETED"]},
        "sample": {"type": "integer", "minimum": 0, "maximum": 116},
        "targetName": {"type": "string", "minLength": 2, "maxLength": 96},
        "flightStatus": {"type": ["string", "null"], "enum": ["SUPERCRUISE_ASSIST_ACTIVE", "SUPERCRUISE_ASSIST_LINE_OF_SIGHT_REQUIRED", "SUPERCRUISE", "FSD_ALIGNMENT_REQUIRED", "SAFE_DISENGAGE_READY", "UNKNOWN", null]},
        "flightPromptText": {"type": ["string", "null"], "maxLength": 128},
        "sphereState": {"type": ["string", "null"], "enum": ["DETECTED", "ABSENT", "UNKNOWN", null]},
        "sphereCenterX": {"type": ["number", "null"]},
        "sphereCenterY": {"type": ["number", "null"]},
        "sphereRadiusPixels": {"type": ["number", "null"], "minimum": 0},
        "signedLimbClearancePixels": {"type": ["number", "null"]},
        "sphereConfidencePermille": {"type": ["integer", "null"], "minimum": 0, "maximum": 1000},
        "directionState": {"type": ["string", "null"], "enum": ["READY", "UNKNOWN", null]},
        "control": {"type": ["string", "null"], "enum": ["PITCH_UP", "PITCH_DOWN", "YAW_LEFT", "YAW_RIGHT", "PITCH_UP_YAW_LEFT", "PITCH_UP_YAW_RIGHT", "PITCH_DOWN_YAW_LEFT", "PITCH_DOWN_YAW_RIGHT", null]},
        "turnPulses": {"type": "integer", "minimum": 0, "maximum": 40},
        "noProgressPulses": {"type": "integer", "minimum": 0, "maximum": 5},
        "absentConfirmations": {"type": "integer", "minimum": 0, "maximum": 3},
        "separationSamples": {"type": "integer", "minimum": 0, "maximum": 60},
        "clearConfirmations": {"type": "integer", "minimum": 0, "maximum": 2},
        "commandedThrottle": {"type": ["integer", "null"], "enum": [0, 100, null]},
        "lastCommand": {"type": ["string", "null"], "maxLength": 64},
        "reason": {"type": ["string", "null"], "maxLength": 192}
      }
    }
  }
}
