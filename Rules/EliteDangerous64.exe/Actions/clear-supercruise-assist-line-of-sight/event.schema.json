{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "payload"],
  "properties": {
    "type": {"const": "action.clear-supercruise-assist-line-of-sight.update"},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "sample", "targetName", "flightStatus", "flightPromptText", "coreCompleted", "control", "directionConfirmations", "turnPulses", "fixedTurnElapsedMs", "separationSamples", "clearConfirmations", "commandedThrottle", "lastCommand", "reason"],
      "properties": {
        "phase": {"enum": ["CONFIRMING_GATE", "CLEARING_CENTERED_SPHERE", "VERIFYING_PROMPT_CLEAR", "COMPLETED"]},
        "sample": {"type": "integer", "minimum": 0, "maximum": 90},
        "targetName": {"type": "string", "minLength": 2, "maxLength": 96},
        "flightStatus": {"type": ["string", "null"], "enum": ["SUPERCRUISE_ASSIST_ACTIVE", "SUPERCRUISE_ASSIST_LINE_OF_SIGHT_REQUIRED", "SUPERCRUISE", "FSD_ALIGNMENT_REQUIRED", "SAFE_DISENGAGE_READY", "UNKNOWN", null]},
        "flightPromptText": {"type": ["string", "null"], "maxLength": 128},
        "coreCompleted": {"type": ["boolean", "null"]},
        "control": {"type": ["string", "null"], "enum": ["PITCH_UP", "PITCH_DOWN", "YAW_LEFT", "YAW_RIGHT", "PITCH_UP_YAW_LEFT", "PITCH_UP_YAW_RIGHT", "PITCH_DOWN_YAW_LEFT", "PITCH_DOWN_YAW_RIGHT", null]},
        "directionConfirmations": {"type": "integer", "minimum": 0, "maximum": 2},
        "turnPulses": {"type": "integer", "minimum": 0, "maximum": 8},
        "fixedTurnElapsedMs": {"type": "integer", "minimum": 0, "maximum": 6400, "multipleOf": 800},
        "separationSamples": {"type": "integer", "minimum": 0, "maximum": 60},
        "clearConfirmations": {"type": "integer", "minimum": 0, "maximum": 2},
        "commandedThrottle": {"type": ["integer", "null"], "enum": [0, null]},
        "lastCommand": {"type": ["string", "null"], "maxLength": 64},
        "reason": {"type": ["string", "null"], "maxLength": 192}
      }
    }
  }
}
