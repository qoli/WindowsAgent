{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "task", "completed", "targetName", "initialTurnCount", "stableInitialHeadingConfirmations", "maximumChargeStartHeatPercent", "chargeStartHeatPercent", "prealignmentProbeCount", "prealignmentTurnCount", "prealignmentCompassUnavailableCount", "prealignmentElapsedMs", "visibleHandoffAttemptCount", "visibleHandoffFailureCount", "escapeVectorDetected", "escapeVectorAlignmentConfirmations", "entryAlignmentEvidence", "escapeVectorAlignmentCommands", "supercruiseEscapeDurationMs", "totalElapsedMs", "finalOcclusionState", "finalStellarCoverageRatio", "finalSupercruiseConfirmed", "restoreHyperspaceDestinationRequired", "finalCommandedThrottle"],
  "properties": {
    "schemaVersion": {"enum": [9, 10]},
    "task": {"const": "CLEAR_HYPERSPACE_OCCLUSION"},
    "completed": {"const": true},
    "targetName": {"type": "string"},
    "initialTurnCount": {"type": "integer", "minimum": 0, "maximum": 30},
    "stableInitialHeadingConfirmations": {"enum": [0, 2]},
    "maximumChargeStartHeatPercent": {"const": 60},
    "chargeStartHeatPercent": {"type": ["integer", "null"], "minimum": 0, "maximum": 60},
    "prealignmentProbeCount": {"type": "integer", "minimum": 0, "maximum": 8},
    "prealignmentTurnCount": {"type": "integer", "minimum": 0, "maximum": 30},
    "prealignmentCompassUnavailableCount": {"type": "integer", "minimum": 0, "maximum": 128},
    "prealignmentElapsedMs": {"type": "integer", "minimum": 0, "maximum": 120000},
    "visibleHandoffAttemptCount": {"type": "integer", "minimum": 0, "maximum": 8},
    "visibleHandoffFailureCount": {"type": "integer", "minimum": 0, "maximum": 8},
    "escapeVectorDetected": {"type": "boolean"},
    "escapeVectorAlignmentConfirmations": {"type": "integer", "minimum": 0, "maximum": 60},
    "entryAlignmentEvidence": {"enum": ["LOCAL_CENTERED_COMPASS", "GAME_SUPERCRUISE_TRANSITION", "DIRECT_SUPERCRUISE_CLEAR_HEADING", "EXISTING_SUPERCRUISE_FIXED_SPHERE_SEPARATION"]},
    "escapeVectorAlignmentCommands": {"type": "integer", "minimum": 0, "maximum": 60},
    "fixedOutwardTurnCompleted": {"type": "boolean"},
    "fixedTurnDurationMs": {"const": 6400},
    "directionConfirmations": {"const": 2},
    "turnPulses": {"const": 8},
    "supercruiseEscapeDurationMs": {"const": 30000},
    "totalElapsedMs": {"type": "integer", "minimum": 0, "maximum": 300000},
    "finalOcclusionState": {"type": ["string", "null"], "enum": ["CLEAR", null]},
    "finalStellarCoverageRatio": {"type": ["number", "null"], "minimum": 0, "maximum": 0.12},
    "finalSupercruiseConfirmed": {"const": true},
    "restoreHyperspaceDestinationRequired": {"const": true},
    "finalCommandedThrottle": {"const": 0}
  }
}
