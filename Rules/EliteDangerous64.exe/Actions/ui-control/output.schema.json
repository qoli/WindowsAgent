{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "selection", "control", "key", "activePreset", "bindingFile"],
  "properties": {
    "schemaVersion": {"const": 1},
    "selection": {"enum": ["UP", "DOWN", "LEFT", "RIGHT", "SELECT", "BACK"]},
    "control": {"enum": ["UI_Up", "UI_Down", "UI_Left", "UI_Right", "UI_Select", "UI_Back"]},
    "key": {"type": "string", "pattern": "^Key_[A-Za-z0-9]+$", "maxLength": 32},
    "activePreset": {"type": "string", "minLength": 1, "maxLength": 128},
    "bindingFile": {"type": "string", "pattern": "^[^/\\\\]+\\.binds$", "maxLength": 260}
  }
}
