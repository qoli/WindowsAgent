{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "closed", "commandSent", "initialState", "finalState"],
  "properties": {
    "schemaVersion": {"const": 1},
    "closed": {"const": true},
    "commandSent": {"type": "boolean"},
    "initialState": {"enum": ["ABSENT", "SYSTEM", "NAVIGATION", "TRANSACTIONS", "CONTACTS"]},
    "finalState": {"const": "ABSENT"}
  }
}
