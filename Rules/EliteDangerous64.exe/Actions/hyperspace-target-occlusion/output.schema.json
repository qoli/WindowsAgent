      "centroidX":{"type":["number","null"],"minimum":0,"maximum":1679},
      "centroidY":{"type":["number","null"],"minimum":0,"maximum":899},
      "escapeVectorX":{"type":["number","null"],"minimum":-1,"maximum":1},
      "escapeVectorY":{"type":["number","null"],"minimum":-1,"maximum":1},
      "directionConfidence":{"type":"number","minimum":0,"maximum":1},
      "recommendedControl":{"type":["string","null"],"enum":["PITCH_UP","PITCH_DOWN","YAW_LEFT","YAW_RIGHT",null]}
    }},
    "profile":{"type":"object"},
    "region":{"type":"object"}
  }
}
