{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object","additionalProperties":false,
  "required":["schemaVersion","occlusion","profile","region"],
  "properties":{
    "schemaVersion":{"const":2},
    "occlusion":{"type":"object","additionalProperties":false,"required":["state","brightPixelCount","warmOrangePixelCount","stellarPixelCount","sampledPixelCount","brightRatio","warmOrangeRatio","stellarCoverageRatio","centerCoverageRatio","clearRatio","blockingCenterRatio","blockingTotalRatio","gridColumns","gridRows","gridCoverageRatios","centroidX","centroidY","escapeVectorX","escapeVectorY","directionConfidence","recommendedControl"],"properties":{
      "state":{"enum":["CLEAR","PARTIAL","BLOCKING","UNKNOWN"]},
