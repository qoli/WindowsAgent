      "warmOrangePixelCount":{"type":"integer","minimum":0,"maximum":60480},
      "stellarPixelCount":{"type":"integer","minimum":0,"maximum":60480},
      "sampledPixelCount":{"const":60480},
      "brightRatio":{"type":"number","minimum":0,"maximum":1},
      "warmOrangeRatio":{"type":"number","minimum":0,"maximum":1},
      "stellarCoverageRatio":{"type":"number","minimum":0,"maximum":1},
      "centerCoverageRatio":{"type":"number","minimum":0,"maximum":1},
      "clearRatio":{"const":0.015},
      "blockingCenterRatio":{"const":0.25},
      "blockingTotalRatio":{"const":0.12},
