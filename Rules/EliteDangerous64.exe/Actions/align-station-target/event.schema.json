{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "payload"],
  "properties": {
    "type": {"const": "action.align-station-target.update"},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "sample", "commandCount", "controlMode", "targetDetected", "targetPresentation", "targetHemisphere", "targetName", "requestedTargetMotion", "effectiveTargetMotion", "targetMotionSource", "compassCascadeMode", "compassSelectedRoute", "compassClassificationConfidence", "compassStrictPrediction", "compassOpponentPrediction", "compassSamplingPath", "compassFallbackUsed", "compassFallbackReason", "offsetX", "offsetY", "centerDistancePixels", "centerZoneInside", "stableConfirmations", "command", "commandHoldMs", "commandResult", "leaseId", "leaseState", "sampleStartedMs", "sampleDurationMs", "sampleIntervalMs", "observedMovementPixels", "controlProgressPixels", "noMovementCount", "distanceDeltaPixels", "awayTrendCount", "reason", "information", "observationErrorCode", "observationError"],
      "properties": {
        "phase": {"enum": ["STOPPING", "OBSERVING", "TURNING_TO_FRONT", "COARSE_ALIGN", "FINE_ALIGN", "VERIFYING_CENTER", "COMPLETED", "TRACKING_WINDOW_COMPLETED", "OBSERVATION_ERROR"]},
        "sample": {"type": "integer", "minimum": 0, "maximum": 240},
        "commandCount": {"type": "integer", "minimum": 0, "maximum": 120},
        "controlMode": {"enum": ["NONE", "SUSTAINED", "PULSE"]},
        "targetDetected": {"type": ["boolean", "null"]},
        "targetPresentation": {"type": ["string", "null"], "enum": ["SOLID", "HOLLOW", "UNKNOWN", null]},
        "targetHemisphere": {"type": ["string", "null"], "enum": ["FRONT", "REAR", "UNKNOWN", null]},
        "targetName": {"type": ["string", "null"], "maxLength": 128},
        "requestedTargetMotion": {"type": ["string", "null"], "enum": ["MOVING", "STATIC", null]},
        "effectiveTargetMotion": {"type": ["string", "null"], "enum": ["MOVING", "STATIC", null]},
        "targetMotionSource": {"type": ["string", "null"], "enum": ["INPUT", "NAV_BEACON_OVERRIDE", null]},
        "compassCascadeMode": {"type": ["string", "null"], "enum": ["OPPONENT_PRIMARY", "STRICT_LOW_OPPONENT_CONFIDENCE", "STRICT_RECOVERY", "CLASS_DISAGREEMENT", "LOW_CONFIDENCE_DISAGREEMENT", "NO_MARKER", null]},
        "compassSelectedRoute": {"type": ["string", "null"], "enum": ["OPPONENT", "STRICT", "NONE", null]},
        "compassClassificationConfidence": {"type": ["number", "null"], "minimum": 0},
        "compassStrictPrediction": {"type": ["string", "null"], "enum": ["NONE", "SOLID", "HOLLOW", null]},
        "compassOpponentPrediction": {"type": ["string", "null"], "enum": ["NONE", "SOLID", "HOLLOW", null]},
        "compassSamplingPath": {"type": ["string", "null"], "enum": ["REFERENCE_FAST_PATH", "WIDE_REFERENCE_FALLBACK", null]},
        "compassFallbackUsed": {"type": ["boolean", "null"]},
        "compassFallbackReason": {"type": ["string", "null"], "enum": ["REFERENCE_GEOMETRY_INSUFFICIENT", "REFERENCE_NO_MARKER", "REFERENCE_CLASS_DISAGREEMENT", "REFERENCE_LOW_CONFIDENCE", null]},
        "offsetX": {"type": ["integer", "null"], "minimum": -95, "maximum": 95},
        "offsetY": {"type": ["integer", "null"], "minimum": -95, "maximum": 95},
        "centerDistancePixels": {"type": ["number", "null"], "minimum": 0, "maximum": 136},
        "centerZoneInside": {"type": ["boolean", "null"]},
        "stableConfirmations": {"type": "integer", "minimum": 0, "maximum": 240},
        "command": {"type": ["string", "null"], "enum": ["SET_THROTTLE_0", "PITCH_UP", "PITCH_DOWN", "YAW_LEFT", "YAW_RIGHT", "ROLL_LEFT", "ROLL_RIGHT", "PITCH_UP_YAW_LEFT", "PITCH_UP_YAW_RIGHT", "PITCH_DOWN_YAW_LEFT", "PITCH_DOWN_YAW_RIGHT", null]},
        "commandHoldMs": {"type": ["integer", "null"], "minimum": 40, "maximum": 1000},
        "commandResult": {"type": ["object", "null"]},
        "leaseId": {"type": ["string", "null"], "pattern": "^key_[0-9a-f]{32}$"},
        "leaseState": {"type": ["string", "null"], "enum": ["ACTIVE", "RELEASED", null]},
        "sampleStartedMs": {"type": ["integer", "null"], "minimum": 0},
        "sampleDurationMs": {"type": ["integer", "null"], "minimum": 0},
        "sampleIntervalMs": {"type": ["integer", "null"], "minimum": 0},
        "observedMovementPixels": {"type": ["number", "null"], "minimum": 0, "maximum": 96},
        "controlProgressPixels": {"type": ["number", "null"], "minimum": -96, "maximum": 96},
        "noMovementCount": {"type": "integer", "minimum": 0, "maximum": 8},
        "distanceDeltaPixels": {"type": ["number", "null"], "minimum": -68, "maximum": 68},
        "awayTrendCount": {"type": "integer", "minimum": 0, "maximum": 5},
        "reason": {"type": ["string", "null"], "maxLength": 256},
        "observationErrorCode": {"type": ["string", "null"], "maxLength": 96},
        "observationError": {"type": ["string", "null"], "maxLength": 512},
        "information": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["code", "message", "recommendedAction"],
          "properties": {
            "code": {"enum": ["ED_PITCH_INPUT_CONTEXT_NOT_READY", "NAV_BEACON_TARGET_MOTION_OVERRIDE"]},
            "message": {"type": "string", "maxLength": 512},
            "recommendedAction": {"type": "string", "maxLength": 512}
          }
        }
      }
    }
  }
}
