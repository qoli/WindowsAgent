{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "task", "completed", "finalPhase", "sampleCount", "commandCount", "stableConfirmations", "finalObservation"],
  "properties": {
    "schemaVersion": {"const": 1},
    "task": {"const": "ALIGN_STATION_TARGET"},
    "completed": {"const": true},
    "finalPhase": {"const": "COMPLETED"},
    "sampleCount": {"type": "integer", "minimum": 3, "maximum": 400},
    "commandCount": {"type": "integer", "minimum": 0, "maximum": 240},
    "stableConfirmations": {"const": 3},
    "finalObservation": {"type": "object"}
  }
}
