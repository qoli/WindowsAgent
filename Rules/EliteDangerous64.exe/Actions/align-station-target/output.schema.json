{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "task", "mode", "targetName", "requestedTargetMotion", "targetMotion", "targetMotionSource", "alignmentPurpose", "controlProfile", "controlProfileSource", "completed", "finalPhase", "sampleCount", "commandCount", "stableConfirmations", "centerContactCount", "maxConsecutiveCenter", "finalObservation"],
  "properties": {
    "schemaVersion": {"const": 3},
    "task": {"const": "ALIGN_STATION_TARGET"},
    "mode": {"enum": ["ALIGN", "TRACK"]},
    "targetName": {"type": ["string", "null"], "maxLength": 128},
    "requestedTargetMotion": {"enum": ["MOVING", "STATIC"]},
    "targetMotion": {"enum": ["MOVING", "STATIC"]},
    "targetMotionSource": {"enum": ["INPUT", "NAV_BEACON_OVERRIDE"]},
    "alignmentPurpose": {"enum": ["CENTER", "VISIBLE_HANDOFF", "HYPERSPACE_CHARGE"]},
    "controlProfile": {"enum": ["NORMAL_SPACE", "SUPERCRUISE_ASSIST"]},
    "controlProfileSource": {"enum": ["INPUT", "STATUS_JSON"]},
    "completed": {"const": true},
    "finalPhase": {"enum": ["COMPLETED", "TRACKING_WINDOW_COMPLETED"]},
    "sampleCount": {"type": "integer", "minimum": 1, "maximum": 400},
    "commandCount": {"type": "integer", "minimum": 0, "maximum": 240},
    "stableConfirmations": {"type": "integer", "minimum": 0, "maximum": 240},
    "centerContactCount": {"type": "integer", "minimum": 0, "maximum": 240},
    "maxConsecutiveCenter": {"type": "integer", "minimum": 0, "maximum": 240},
    "finalObservation": {"type": "object"}
  }
}
