{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profile", "coordinateSpace", "region", "physicalRegion", "samplingPath", "fallbackUsed", "attempts", "sampling", "compass", "routes", "target"],
  "properties": {
    "schemaVersion": {"const": 8},
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "capturedAt"],
      "properties": {
        "width": {"type": "integer", "minimum": 1, "maximum": 16384},
        "height": {"type": "integer", "minimum": 1, "maximum": 16384},
        "capturedAt": {"type": "string", "format": "date-time", "maxLength": 64}
      }
    },
    "coordinateSpace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "fit"],
      "properties": {
        "width": {"const": 1920},
        "height": {"const": 1080},
        "fit": {"const": "centered-16:9"}
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "w", "h"],
      "properties": {
        "x": {"const": 682},
        "y": {"const": 771},
        "w": {"const": 96},
        "h": {"const": 96}
      }
    },
    "physicalRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left", "top", "width", "height"],
      "properties": {
        "left": {"type": "integer", "minimum": 0, "maximum": 16383},
        "top": {"type": "integer", "minimum": 0, "maximum": 16383},
        "width": {"type": "integer", "minimum": 1, "maximum": 16384},
        "height": {"type": "integer", "minimum": 1, "maximum": 16384}
      }
    },
    "samplingPath": {"enum": ["REFERENCE_FAST_PATH", "NATIVE_FALLBACK"]},
    "fallbackUsed": {"type": "boolean"},
    "attempts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/attempt"}
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "imageWidth", "imageHeight", "scaleX", "scaleY"],
      "properties": {
        "mode": {"enum": ["reference", "native"]},
        "imageWidth": {"type": "integer", "minimum": 1, "maximum": 256},
        "imageHeight": {"type": "integer", "minimum": 1, "maximum": 256},
        "scaleX": {"type": "number", "exclusiveMinimum": 0, "maximum": 3},
        "scaleY": {"type": "number", "exclusiveMinimum": 0, "maximum": 3}
      }
    },
    "compass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visible", "orangePixelCount", "minimumOrangePixelCount", "circleCenterX", "circleCenterY", "circleRadiusPixels", "circleCandidateCount", "houghPerimeterSamples", "houghVotes", "angularCoverageBins", "annulusDensity", "orangeFraction"],
      "properties": {
        "visible": {"const": true},
        "orangePixelCount": {"type": "integer", "minimum": 1, "maximum": 65536},
        "minimumOrangePixelCount": {"type": "integer", "minimum": 1, "maximum": 65536},
        "circleCenterX": {"type": "integer", "minimum": 682, "maximum": 777},
        "circleCenterY": {"type": "integer", "minimum": 771, "maximum": 866},
        "circleRadiusPixels": {"type": "integer", "minimum": 24, "maximum": 44},
        "circleCandidateCount": {"type": "integer", "minimum": 1},
        "houghPerimeterSamples": {"const": 24},
        "houghVotes": {"type": "integer", "minimum": 4},
        "angularCoverageBins": {"type": "integer", "minimum": 16, "maximum": 24},
        "annulusDensity": {"type": "number", "minimum": 0, "maximum": 0.75},
        "orangeFraction": {"type": "number", "minimum": 0, "maximum": 0.55}
      }
    },
    "routes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strict", "opponent"],
      "properties": {
        "strict": {"$ref": "#/$defs/route"},
        "opponent": {"$ref": "#/$defs/route"}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["detected", "presentation", "hemisphere", "cascadeMode", "selectedRoute", "classificationConfidence", "markerBounds", "referenceX", "referenceY", "offsetX", "offsetY", "screenAngleDegrees", "centerDistancePixels", "centerZone"],
      "properties": {
        "detected": {"type": "boolean"},
        "presentation": {"enum": ["SOLID", "HOLLOW", "UNKNOWN"]},
        "hemisphere": {"enum": ["FRONT", "REAR", "UNKNOWN"]},
        "cascadeMode": {"enum": ["OPPONENT_PRIMARY", "STRICT_LOW_OPPONENT_CONFIDENCE", "STRICT_RECOVERY", "CLASS_DISAGREEMENT", "LOW_CONFIDENCE_DISAGREEMENT", "NO_MARKER"]},
        "selectedRoute": {"enum": ["OPPONENT", "STRICT", "NONE"]},
        "classificationConfidence": {"type": "number", "minimum": 0},
        "markerBounds": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["x", "y", "w", "h", "centerX", "centerY"],
          "properties": {
            "x": {"type": "integer", "minimum": 682, "maximum": 777},
            "y": {"type": "integer", "minimum": 771, "maximum": 866},
            "w": {"type": "integer", "minimum": 1, "maximum": 96},
            "h": {"type": "integer", "minimum": 1, "maximum": 96},
            "centerX": {"type": "integer", "minimum": 682, "maximum": 777},
            "centerY": {"type": "integer", "minimum": 771, "maximum": 866}
          }
        },
        "referenceX": {"type": ["integer", "null"], "minimum": 682, "maximum": 777},
        "referenceY": {"type": ["integer", "null"], "minimum": 771, "maximum": 866},
        "offsetX": {"type": ["integer", "null"], "minimum": -95, "maximum": 95},
        "offsetY": {"type": ["integer", "null"], "minimum": -95, "maximum": 95},
        "screenAngleDegrees": {"type": ["number", "null"], "minimum": 0, "exclusiveMaximum": 360},
        "centerDistancePixels": {"type": ["number", "null"], "minimum": 0, "maximum": 136},
        "centerZone": {
          "type": "object",
          "additionalProperties": false,
          "required": ["shape", "radiusPixels", "inside"],
          "properties": {
            "shape": {"const": "circle"},
            "radiusPixels": {"const": 4},
            "inside": {"type": ["boolean", "null"]}
          }
        }
      }
    }
  },
  "$defs": {
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sampling", "capturedAt", "imageWidth", "imageHeight", "geometryVerified", "strictPrediction", "strictConfidence", "opponentPrediction", "opponentConfidence", "outcome", "reason"],
      "properties": {
        "sampling": {"enum": ["reference", "native"]},
        "capturedAt": {"type": "string", "format": "date-time", "maxLength": 64},
        "imageWidth": {"type": "integer", "minimum": 1, "maximum": 256},
        "imageHeight": {"type": "integer", "minimum": 1, "maximum": 256},
        "geometryVerified": {"type": "boolean"},
        "strictPrediction": {"enum": ["NONE", "SOLID", "HOLLOW"]},
        "strictConfidence": {"type": "number", "minimum": 0},
        "opponentPrediction": {"enum": ["NONE", "SOLID", "HOLLOW"]},
        "opponentConfidence": {"type": "number", "minimum": 0},
        "outcome": {"enum": ["ACCEPTED", "ESCALATED"]},
        "reason": {"enum": ["REFERENCE_DUAL_ROUTE_CONFIRMED", "REFERENCE_GEOMETRY_INSUFFICIENT", "REFERENCE_NO_MARKER", "REFERENCE_CLASS_DISAGREEMENT", "REFERENCE_LOW_CONFIDENCE", "NATIVE_FALLBACK_COMPLETED"]}
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prediction", "confidence", "solidScore", "hollowScore", "clusterCount"],
      "properties": {
        "prediction": {"enum": ["NONE", "SOLID", "HOLLOW"]},
        "confidence": {"type": "number", "minimum": 0},
        "solidScore": {"type": "number", "minimum": 0},
        "hollowScore": {"type": "number", "minimum": 0},
        "clusterCount": {"type": "integer", "minimum": 0}
      }
    }
  }
}
