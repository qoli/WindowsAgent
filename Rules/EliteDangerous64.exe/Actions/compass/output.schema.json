{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profile",
    "coordinateSpace",
    "region",
    "physicalRegion",
    "compass",
    "target"
  ],
  "properties": {
    "schemaVersion": {"const": 4},
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "capturedAt"],
      "properties": {
        "width": {"type": "integer", "minimum": 1, "maximum": 16384},
        "height": {"type": "integer", "minimum": 1, "maximum": 16384},
        "capturedAt": {"type": "string", "format": "date-time", "maxLength": 64}
      }
    },
    "coordinateSpace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "fit"],
      "properties": {
        "width": {"const": 1920},
        "height": {"const": 1080},
        "fit": {"const": "centered-16:9"}
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "w", "h", "centerX", "centerY"],
      "properties": {
        "x": {"const": 682},
        "y": {"const": 771},
        "w": {"const": 96},
        "h": {"const": 96},
        "centerX": {"const": 730},
        "centerY": {"const": 819}
      }
    },
    "physicalRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left", "top", "width", "height"],
      "properties": {
        "left": {"type": "integer", "minimum": 0, "maximum": 16383},
        "top": {"type": "integer", "minimum": 0, "maximum": 16383},
        "width": {"type": "integer", "minimum": 1, "maximum": 16384},
        "height": {"type": "integer", "minimum": 1, "maximum": 16384}
      }
    },
    "compass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visible", "orangePixelCount"],
      "properties": {
        "visible": {"const": true},
        "orangePixelCount": {"type": "integer", "minimum": 150, "maximum": 9216}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "detected",
        "candidateCyanPixelCount",
        "cyanPixelCount",
        "coreCyanPixelCount",
        "centerCyanPixelCount",
        "markerBounds",
        "presentation",
        "hemisphere",
        "referenceX",
        "referenceY",
        "offsetX",
        "offsetY",
        "screenAngleDegrees",
        "centerDistancePixels",
        "centerZone"
      ],
      "properties": {
        "detected": {"type": "boolean"},
        "candidateCyanPixelCount": {"type": "integer", "minimum": 0, "maximum": 9216},
        "cyanPixelCount": {"type": "integer", "minimum": 0, "maximum": 9216},
        "coreCyanPixelCount": {"type": "integer", "minimum": 0, "maximum": 25},
        "centerCyanPixelCount": {"type": "integer", "minimum": 0, "maximum": 9},
        "markerBounds": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["x", "y", "w", "h", "centerX", "centerY"],
          "properties": {
            "x": {"type": "integer", "minimum": 682, "maximum": 777},
            "y": {"type": "integer", "minimum": 771, "maximum": 866},
            "w": {"type": "integer", "minimum": 1, "maximum": 96},
            "h": {"type": "integer", "minimum": 1, "maximum": 96},
            "centerX": {"type": "integer", "minimum": 682, "maximum": 777},
            "centerY": {"type": "integer", "minimum": 771, "maximum": 866}
          }
        },
        "presentation": {"enum": ["SOLID", "HOLLOW", "UNKNOWN"]},
        "hemisphere": {"enum": ["FRONT", "REAR", "UNKNOWN"]},
        "referenceX": {"type": ["integer", "null"], "minimum": 682, "maximum": 777},
        "referenceY": {"type": ["integer", "null"], "minimum": 771, "maximum": 866},
        "offsetX": {"type": ["integer", "null"], "minimum": -48, "maximum": 47},
        "offsetY": {"type": ["integer", "null"], "minimum": -48, "maximum": 47},
        "screenAngleDegrees": {
          "type": ["number", "null"],
          "minimum": 0,
          "exclusiveMaximum": 360
        },
        "centerDistancePixels": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 68
        },
        "centerZone": {
          "type": "object",
          "additionalProperties": false,
          "required": ["shape", "radiusPixels", "inside"],
          "properties": {
            "shape": {"const": "circle"},
            "radiusPixels": {"const": 4},
            "inside": {"type": ["boolean", "null"]}
          }
        }
      }
    }
  }
}
