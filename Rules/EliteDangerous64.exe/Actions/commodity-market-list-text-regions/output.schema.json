{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": {"type": "number", "minimum": 0, "maximum": 4096},
        "y": {"type": "number", "minimum": 0, "maximum": 2160}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "regions", "evidence", "models", "timing"],
  "properties": {
    "schemaVersion": {"const": 1},
    "regions": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["points", "referencePoints", "detectionConfidence", "text", "recognitionConfidence", "leftContext"],
        "properties": {
          "points": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/point"}},
          "referencePoints": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/point"}},
          "detectionConfidence": {"type": "number", "minimum": 0, "maximum": 1},
          "text": {"type": "string", "maxLength": 256},
          "recognitionConfidence": {"type": "number", "minimum": 0, "maximum": 1},
          "leftContext": {"type": "object"}
        }
      }
    },
    "evidence": {"type": "object"},
    "models": {"type": "object"},
    "timing": {"type": "object"}
  }
}
