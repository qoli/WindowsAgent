{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "payload"],
  "properties": {
    "type": {"const": "action.dock-at-station.update"},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "sample", "contactIndex", "rangeState", "distanceMeters", "requestDocking", "flightStatus", "landingGear", "autoDockSeen", "autoDockConsecutive", "autoDockMissingSamples", "landingGearOnConsecutive", "lastCommand", "reason", "observationErrorCount", "observationError"],
      "properties": {
        "phase": {"enum": ["NORMALIZING_RANGE_VIEW", "RANGE_ADMITTED", "OPENING_CONTACTS", "LOCATING_REQUEST", "FOCUSING_REQUEST", "REQUESTING_DOCKING", "VERIFYING_GRANTED", "CLOSING_PANEL", "HANDING_OVER", "AUTO_DOCK_WAIT", "SLOWING_FOR_AUTO_DOCK", "AUTO_DOCK_ACTIVE", "FINAL_APPROACH", "OBSERVATION_ERROR", "VISUAL_CONFIRMATION_REQUIRED"]},
        "sample": {"type": "integer", "minimum": 0, "maximum": 2000},
        "contactIndex": {"type": "integer", "minimum": 0, "maximum": 15},
        "rangeState": {"enum": ["ALLOWED", null]},
        "distanceMeters": {"type": ["number", "null"], "minimum": 0},
        "requestDocking": {"enum": ["AVAILABLE", "FOCUSED", "UNAVAILABLE", "DOCKING_ACTIVE", "UNKNOWN", null]},
        "flightStatus": {"enum": ["SUPERCRUISE", "AUTO_LAUNCH", "WAITING_IN_QUEUE", "SLOW_DOWN_FOR_AUTO_DOCK", "FSD_CHARGING", "FSD_ALIGNMENT_REQUIRED", "AUTO_DOCK", "UNKNOWN", null]},
        "landingGear": {"enum": ["ON", "OFF", "UNKNOWN", null]},
        "autoDockSeen": {"type": "boolean"},
        "autoDockConsecutive": {"type": "integer", "minimum": 0, "maximum": 2},
        "autoDockMissingSamples": {"type": "integer", "minimum": 0, "maximum": 1800},
        "landingGearOnConsecutive": {"type": "integer", "minimum": 0, "maximum": 1800},
        "lastCommand": {"enum": ["FOCUS_LEFT_PANEL", "NEXT_PANEL", "DOWN", "RIGHT", "SELECT", "SET_THROTTLE_0", null]},
        "reason": {"type": ["string", "null"], "maxLength": 256},
        "observationErrorCount": {"type": "integer", "minimum": 0, "maximum": 3},
        "observationError": {"type": ["string", "null"], "maxLength": 512}
      }
    }
  }
}
