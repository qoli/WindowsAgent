{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "task", "completed", "controlCount", "focusBaseline", "initialServiceFocus", "rightMovesToRefuel", "refuelFocusConfirmed", "repairFocusConfirmed", "refuelAttempted", "repairAttempted", "autoLaunchSelected", "awaitingFinalSelect", "refuelCommand", "repairCommand", "autoLaunchCommand"],
  "properties": {
    "schemaVersion": {"const": 1},
    "task": {"const": "PREPARE_AUTO_LAUNCH"},
    "completed": {"const": true},
    "controlCount": {"type": "integer", "minimum": 15, "maximum": 19},
    "focusBaseline": {"const": "DISEMBARK"},
    "initialServiceFocus": {"enum": ["REFUEL", "REPAIR", "RESTOCK", "LAYER_SWITCH"]},
    "rightMovesToRefuel": {"type": "integer", "minimum": 0, "maximum": 3},
    "refuelFocusConfirmed": {"const": true},
    "repairFocusConfirmed": {"const": true},
    "refuelAttempted": {"const": true},
    "repairAttempted": {"const": true},
    "autoLaunchSelected": {"type": "boolean"},
    "awaitingFinalSelect": {"type": "boolean"},
    "refuelCommand": {"$ref": "#/$defs/command"},
    "repairCommand": {"$ref": "#/$defs/command"},
    "autoLaunchCommand": {"oneOf": [{"$ref": "#/$defs/command"}, {"type": "null"}]}
  },
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "selection", "control", "key", "activePreset", "bindingFile", "bindingSource", "backend", "scanCode", "extended", "holdMs"],
      "properties": {
        "schemaVersion": {"const": 1},
        "selection": {"const": "SELECT"},
        "control": {"const": "UI_Select"},
        "key": {"type": "string", "pattern": "^Key_[A-Za-z0-9]+$", "maxLength": 32},
        "activePreset": {"type": "string", "minLength": 1, "maxLength": 128},
        "bindingFile": {"type": "string", "pattern": "^[^/\\\\]+\\.binds$", "maxLength": 260},
        "bindingSource": {"const": "frontier-active-preset-v1"},
        "backend": {"const": "sendinput-scancode"},
        "scanCode": {"type": "integer", "minimum": 1, "maximum": 255},
        "extended": {"type": "boolean"},
        "holdMs": {"const": 40}
      }
    }
  }
}
