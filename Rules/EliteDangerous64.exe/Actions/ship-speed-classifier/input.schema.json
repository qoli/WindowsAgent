{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["ocr", "glyph"],
  "properties": {
    "ocr": {
      "type": "object",
      "required": ["schemaVersion", "text", "confidence", "decoding", "evidence", "model", "timing"]
    },
    "glyph": {
      "type": "object",
      "required": ["schemaVersion", "profile", "coordinateSpace", "region", "physicalRegion", "zeroGlyph"]
    }
  }
}
