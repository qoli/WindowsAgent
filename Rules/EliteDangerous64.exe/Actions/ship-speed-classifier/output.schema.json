{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profile", "coordinateSpace", "region", "physicalRegion", "speed", "evidence"],
  "properties": {
    "schemaVersion": {"const": 1},
    "profile": {"type": "object"},
    "coordinateSpace": {"type": "object"},
    "region": {"type": "object"},
    "physicalRegion": {"type": "object"},
    "speed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "displayValue", "unit", "referencePoints", "evidence"],
      "properties": {
        "state": {"enum": ["KNOWN", "UNKNOWN"]},
        "displayValue": {"type": ["integer", "null"], "minimum": 0, "maximum": 9999},
        "unit": {"type": "null"},
        "referencePoints": {"type": ["array", "null"]},
        "evidence": {"type": "object"}
      }
    },
    "evidence": {"type": "object"}
  }
}
