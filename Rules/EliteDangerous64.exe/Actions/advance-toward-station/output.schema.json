{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "task", "completed", "finalPhase", "throttlePercent", "stopAtStationDistanceMeters", "initialStationDistanceMeters", "finalStationDistanceMeters", "elapsedMs", "sampleCount", "stopResult"],
  "properties": {
    "schemaVersion": {"const": 1},
    "task": {"const": "ADVANCE_TOWARD_STATION"},
    "completed": {"const": true},
    "finalPhase": {"enum": ["TARGET_ALREADY_REACHED", "STATION_DISTANCE_REACHED"]},
    "throttlePercent": {"enum": [75, 100]},
    "stopAtStationDistanceMeters": {"type": "number", "minimum": 1000, "exclusiveMaximum": 7500},
    "initialStationDistanceMeters": {"type": "number", "minimum": 0},
    "finalStationDistanceMeters": {"type": "number", "minimum": 0},
    "elapsedMs": {"type": "integer", "minimum": 0},
    "sampleCount": {"type": "integer", "minimum": 2},
    "stopResult": {"type": "object"}
  }
}
