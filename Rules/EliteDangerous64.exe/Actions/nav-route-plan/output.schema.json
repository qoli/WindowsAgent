{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "state", "routeId", "freshness", "sourceTimestamp", "origin", "destination", "jumpCount", "hops"],
  "properties": {
    "schemaVersion": {"const": 1},
    "state": {"const": "READY"},
    "routeId": {"type": "string", "minLength": 5, "maxLength": 256},
    "freshness": {"enum": ["CURRENT", "UNKNOWN"]},
    "sourceTimestamp": {"type": "string", "format": "date-time", "maxLength": 64},
    "origin": {"$ref": "#/$defs/system"},
    "destination": {"$ref": "#/$defs/system"},
    "jumpCount": {"type": "integer", "minimum": 1, "maximum": 32},
    "hops": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "allOf": [
          {"$ref": "#/$defs/system"},
          {"type": "object", "required": ["index"], "properties": {"index": {"type": "integer", "minimum": 1, "maximum": 32}}}
        ]
      }
    }
  },
  "$defs": {
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "systemAddress", "starClass", "starPos"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 96},
        "systemAddress": {"type": "integer", "minimum": 1},
        "starClass": {"type": "string", "minLength": 1, "maxLength": 16},
        "starPos": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
        "index": {"type": "integer", "minimum": 1, "maximum": 32}
      }
    }
  }
}
