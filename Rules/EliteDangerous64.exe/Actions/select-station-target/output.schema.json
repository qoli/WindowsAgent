{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "task", "completed", "result", "stationName", "targetLocked", "selectSent", "selectAttemptCount", "openedPanel", "restoredView", "panelCycleCount", "navigationCount", "observationCount", "finalObservation"],
  "properties": {
    "schemaVersion": {"const": 1},
    "task": {"const": "SELECT_STATION_TARGET"},
    "completed": {"const": true},
    "result": {"enum": ["EXISTING", "ACQUIRED"]},
    "stationName": {"type": "string", "minLength": 2, "maxLength": 64},
    "targetLocked": {"const": true},
    "selectSent": {"type": "boolean"},
    "selectAttemptCount": {"type": "integer", "minimum": 0, "maximum": 2},
    "openedPanel": {"type": "boolean"},
    "restoredView": {"type": "boolean"},
    "panelCycleCount": {"type": "integer", "minimum": 0, "maximum": 3},
    "navigationCount": {"type": "integer", "minimum": 0, "maximum": 8},
    "observationCount": {"type": "integer", "minimum": 2, "maximum": 96},
    "finalObservation": {"type": "object"}
  }
}
