{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["control"],
  "properties": {
    "control": {
      "enum": ["PITCH_UP", "PITCH_DOWN", "YAW_LEFT", "YAW_RIGHT", "ROLL_LEFT", "ROLL_RIGHT"]
    },
    "holdMs": {"type": "integer", "minimum": 40, "maximum": 1000}
  }
}
