{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profile", "coordinateSpace", "samples", "activeTab"],
  "properties": {
    "schemaVersion": {"const": 3},
    "profile": {"type": "object"},
    "coordinateSpace": {"type": "object"},
    "samples": {
      "type": "object",
      "additionalProperties": false,
      "required": ["SYSTEM", "NAVIGATION", "TRANSACTIONS", "CONTACTS"],
      "properties": {
        "SYSTEM": {"$ref": "#/$defs/sample"},
        "NAVIGATION": {"$ref": "#/$defs/sample"},
        "TRANSACTIONS": {"$ref": "#/$defs/sample"},
        "CONTACTS": {"$ref": "#/$defs/sample"}
      }
    },
    "activeTab": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "highlightRatios", "selectedMinimum", "inactiveMaximum", "absentMaximum", "reason"],
      "properties": {
        "state": {"enum": ["SYSTEM", "NAVIGATION", "TRANSACTIONS", "CONTACTS", "ABSENT", "UNKNOWN"]},
        "highlightRatios": {
          "type": "object",
          "additionalProperties": false,
          "required": ["SYSTEM", "NAVIGATION", "TRANSACTIONS", "CONTACTS"],
          "properties": {
            "SYSTEM": {"type": "number", "minimum": 0, "maximum": 1},
            "NAVIGATION": {"type": "number", "minimum": 0, "maximum": 1},
            "TRANSACTIONS": {"type": "number", "minimum": 0, "maximum": 1},
            "CONTACTS": {"type": "number", "minimum": 0, "maximum": 1}
          }
        },
        "selectedMinimum": {"const": 0.75},
        "inactiveMaximum": {"const": 0.25},
        "absentMaximum": {"const": 0.25},
        "reason": {"type": "string", "maxLength": 64}
      }
    }
  },
  "$defs": {
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["referenceRegion", "physicalRegion", "capturedAt", "highlightRatio"],
      "properties": {
        "referenceRegion": {"type": "object"},
        "physicalRegion": {"type": "object"},
        "capturedAt": {"type": "string", "minLength": 1},
        "highlightRatio": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
