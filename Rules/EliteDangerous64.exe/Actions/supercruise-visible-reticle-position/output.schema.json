{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "target", "evidence"],
  "properties": {
    "schemaVersion": {"const": 1},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "referenceX", "referenceY", "offsetX", "offsetY", "centerDistancePixels", "reason", "bestScore", "secondScore"],
      "properties": {
        "state": {"enum": ["DETECTED", "UNKNOWN"]},
        "referenceX": {"type": ["number", "null"]},
        "referenceY": {"type": ["number", "null"]},
        "offsetX": {"type": ["number", "null"]},
        "offsetY": {"type": ["number", "null"]},
        "centerDistancePixels": {"type": ["number", "null"], "minimum": 0},
        "reason": {"type": "string"},
        "bestScore": {"type": "integer", "minimum": 0},
        "secondScore": {"type": "integer", "minimum": 0}
      }
    },
    "evidence": {"type": "object"}
  }
}
