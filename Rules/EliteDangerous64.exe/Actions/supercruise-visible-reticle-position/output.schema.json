{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "target", "evidence"],
  "properties": {
    "schemaVersion": {"const": 1},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "referenceX", "referenceY", "offsetX", "offsetY", "centerDistancePixels", "reason", "bestScore", "secondScore", "presentation", "occupiedAngularBins", "angularRuns", "evidencePlane", "evidenceQuality", "shapeConfidencePermille", "alphaInvariantOrangeScore", "structuralCoverage", "radiusMAD", "orientationCoherence", "arcConfidencePermille", "circleFitPointCount", "circleFitInlierCount", "circleFitResidualP95", "centerCovarianceXX", "centerCovarianceXY", "centerCovarianceYY", "centerCovarianceTrace", "runnerUpReferenceX", "runnerUpReferenceY", "runnerUpSupport", "runnerUpResidualP95", "runnerUpCenterDistancePixels", "centerModeCount"],
      "properties": {
        "state": {"enum": ["DETECTED", "UNKNOWN"]},
        "referenceX": {"type": ["number", "null"]},
        "referenceY": {"type": ["number", "null"]},
        "offsetX": {"type": ["number", "null"]},
        "offsetY": {"type": ["number", "null"]},
        "centerDistancePixels": {"type": ["number", "null"], "minimum": 0},
        "reason": {"type": "string"},
        "bestScore": {"type": "integer", "minimum": 0},
        "secondScore": {"type": "integer", "minimum": 0},
        "presentation": {"enum": ["SOLID", "DASHED", null]},
        "occupiedAngularBins": {"type": "integer", "minimum": 0, "maximum": 72},
        "angularRuns": {"type": "integer", "minimum": 0, "maximum": 36},
        "evidencePlane": {"enum": ["STRICT_RGB", "ORANGE_OPPONENT", "HSV_ORANGE", null]},
        "evidenceQuality": {"type": ["integer", "null"], "minimum": 0},
        "shapeConfidencePermille": {"type": ["integer", "null"], "minimum": 0, "maximum": 1000},
        "alphaInvariantOrangeScore": {"type": ["integer", "null"], "minimum": 0, "maximum": 255},
        "structuralCoverage": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "radiusMAD": {"type": ["number", "null"], "minimum": 0},
        "orientationCoherence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "arcConfidencePermille": {"type": ["integer", "null"], "minimum": 0, "maximum": 1000},
        "circleFitPointCount": {"type": ["integer", "null"], "minimum": 0, "maximum": 54},
        "circleFitInlierCount": {"type": ["integer", "null"], "minimum": 0, "maximum": 54},
        "circleFitResidualP95": {"type": ["number", "null"], "minimum": 0},
        "centerCovarianceXX": {"type": ["number", "null"], "minimum": 0},
        "centerCovarianceXY": {"type": ["number", "null"]},
        "centerCovarianceYY": {"type": ["number", "null"], "minimum": 0},
        "centerCovarianceTrace": {"type": ["number", "null"], "minimum": 0},
        "runnerUpReferenceX": {"type": ["number", "null"]},
        "runnerUpReferenceY": {"type": ["number", "null"]},
        "runnerUpSupport": {"type": ["integer", "null"], "minimum": 0, "maximum": 54},
        "runnerUpResidualP95": {"type": ["number", "null"], "minimum": 0},
        "runnerUpCenterDistancePixels": {"type": ["number", "null"], "minimum": 0},
        "centerModeCount": {"type": ["integer", "null"], "minimum": 0, "maximum": 2}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region", "physicalRegion", "capturedAt", "selectedPlane", "requestedPolicy", "selectionReason", "planes"],
      "properties": {
        "region": {"type": "object"},
        "physicalRegion": {"type": "object"},
        "capturedAt": {"type": "string"},
        "selectedPlane": {"enum": ["STRICT_RGB", "ORANGE_OPPONENT", "HSV_ORANGE", null]},
        "requestedPolicy": {"enum": ["ADAPTIVE_ORANGE", "OCCLUSION_AWARE", "HUD_OVERLAY_AWARE"]},
        "selectionReason": {"type": "string"},
        "planes": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "state", "reason", "thresholdMethod", "threshold", "nonzeroCount", "nonzeroRatioPermille", "thresholdDegenerate", "pixelCount", "referenceX", "referenceY", "quality", "ringScore", "secondQuality", "clutterScore", "centerMargin", "occupiedAngularBins", "angularTransitions", "angularRuns", "structuralArcOccupiedBins", "labelSectorOccupiedBins", "structuralCoveragePermille", "labelGapClarityPermille", "radialContrastPermille", "centerUniquenessPermille", "shapeConfidencePermille", "alphaInvariantOrangeScore", "structuralCoverage", "radiusMAD", "orientationCoherence", "arcConfidencePermille", "circleFitPointCount", "circleFitInlierCount", "circleFitResidualP95", "centerCovarianceXX", "centerCovarianceXY", "centerCovarianceYY", "centerCovarianceTrace", "runnerUpReferenceX", "runnerUpReferenceY", "runnerUpSupport", "runnerUpResidualP95", "runnerUpCenterDistancePixels", "centerModeCount", "presentation"],
            "properties": {
              "name": {"enum": ["STRICT_RGB", "ORANGE_OPPONENT", "HSV_ORANGE"]},
              "state": {"enum": ["VIABLE", "REJECTED"]},
              "reason": {"type": "string"},
              "thresholdMethod": {"enum": ["FIXED_STRICT_RGB", "OTSU", "FIXED_ALPHA_INVARIANT"]},
              "threshold": {"type": "integer", "minimum": 0, "maximum": 255},
              "nonzeroCount": {"type": "integer", "minimum": 0, "maximum": 19600},
              "nonzeroRatioPermille": {"type": "integer", "minimum": 0, "maximum": 1000},
              "thresholdDegenerate": {"type": "boolean"},
              "pixelCount": {"type": "integer", "minimum": 0, "maximum": 19600},
              "referenceX": {"type": "integer"},
              "referenceY": {"type": "integer"},
              "quality": {"type": "integer"},
              "ringScore": {"type": "integer", "minimum": 0},
              "secondQuality": {"type": "integer", "minimum": 0},
              "clutterScore": {"type": "integer", "minimum": 0},
              "centerMargin": {"type": "integer"},
              "occupiedAngularBins": {"type": "integer", "minimum": 0, "maximum": 72},
              "angularTransitions": {"type": "integer", "minimum": 0, "maximum": 72},
              "angularRuns": {"type": "integer", "minimum": 0, "maximum": 36},
              "structuralArcOccupiedBins": {"type": "integer", "minimum": 0, "maximum": 54},
              "labelSectorOccupiedBins": {"type": "integer", "minimum": 0, "maximum": 18},
              "structuralCoveragePermille": {"type": "integer", "minimum": 0, "maximum": 1000},
              "labelGapClarityPermille": {"type": "integer", "minimum": 0, "maximum": 1000},
              "radialContrastPermille": {"type": "integer", "minimum": 0, "maximum": 1000},
              "centerUniquenessPermille": {"type": "integer", "minimum": 0, "maximum": 1000},
              "shapeConfidencePermille": {"type": "integer", "minimum": 0, "maximum": 1000},
              "alphaInvariantOrangeScore": {"type": "integer", "minimum": 0, "maximum": 255},
              "structuralCoverage": {"type": "number", "minimum": 0, "maximum": 1},
              "radiusMAD": {"type": "number", "minimum": 0},
              "orientationCoherence": {"type": "number", "minimum": 0, "maximum": 1},
              "arcConfidencePermille": {"type": "integer", "minimum": 0, "maximum": 1000},
              "circleFitPointCount": {"type": "integer", "minimum": 0, "maximum": 54},
              "circleFitInlierCount": {"type": "integer", "minimum": 0, "maximum": 54},
              "circleFitResidualP95": {"type": ["number", "null"], "minimum": 0},
              "centerCovarianceXX": {"type": ["number", "null"], "minimum": 0},
              "centerCovarianceXY": {"type": ["number", "null"]},
              "centerCovarianceYY": {"type": ["number", "null"], "minimum": 0},
              "centerCovarianceTrace": {"type": ["number", "null"], "minimum": 0},
              "runnerUpReferenceX": {"type": ["number", "null"]},
              "runnerUpReferenceY": {"type": ["number", "null"]},
              "runnerUpSupport": {"type": "integer", "minimum": 0, "maximum": 54},
              "runnerUpResidualP95": {"type": ["number", "null"], "minimum": 0},
              "runnerUpCenterDistancePixels": {"type": ["number", "null"], "minimum": 0},
              "centerModeCount": {"type": "integer", "minimum": 0, "maximum": 2},
              "presentation": {"enum": ["SOLID", "DASHED", null]}
            }
          }
        }
      }
    }
  }
}
