{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "task", "completed", "finalPhase", "contactsState", "selected", "openedPanel", "cycleCount", "observationCount", "finalObservation"],
  "properties": {
    "schemaVersion": {"const": 1},
    "task": {"const": "SELECT_CONTACTS_PANEL"},
    "completed": {"const": true},
    "finalPhase": {"const": "CONTACTS_SELECTED"},
    "contactsState": {"const": "SELECTED"},
    "selected": {"const": true},
    "openedPanel": {"type": "boolean"},
    "cycleCount": {"type": "integer", "minimum": 0, "maximum": 3},
    "observationCount": {"type": "integer", "minimum": 2, "maximum": 20},
    "finalObservation": {"type": "object"}
  }
}
