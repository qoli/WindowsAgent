{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "hyperspaceState"],
  "properties": {
    "schemaVersion": {"const": 1},
    "hyperspaceState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "flightStatus", "promptText", "cockpitHud", "evidenceCapturedAt"],
      "properties": {
        "state": {"enum": ["FSD_CHARGING", "ALIGNMENT_REQUIRED", "COCKPIT_PRESENT", "COCKPIT_ABSENT"]},
        "flightStatus": {"enum": ["SUPERCRUISE_ASSIST_ACTIVE", "SUPERCRUISE_ASSIST_LINE_OF_SIGHT_REQUIRED", "SUPERCRUISE", "AUTO_LAUNCH", "WAITING_IN_QUEUE", "SLOW_DOWN_FOR_AUTO_DOCK", "FSD_CHARGING", "FSD_ALIGNMENT_REQUIRED", "SAFE_DISENGAGE_READY", "AUTO_DOCK", "UNKNOWN"]},
        "promptText": {"type": "string", "maxLength": 512},
        "cockpitHud": {"type": "object"},
        "evidenceCapturedAt": {"type": "string", "format": "date-time", "maxLength": 64}
      }
    }
  }
}
