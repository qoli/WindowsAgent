{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["targetSystem", "maxJumps"],
  "properties": {
    "targetSystem": {"type": "string", "minLength": 2, "maxLength": 96, "pattern": "^\\S(?:.*\\S)?$"},
    "maxJumps": {"type": "integer", "minimum": 1, "maximum": 32},
    "refreshExistingContext": {"type": "boolean", "default": false}
  }
}
