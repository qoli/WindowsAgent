{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "state", "source", "events"],
  "properties": {
    "schemaVersion": {"const": 1},
    "state": {"enum": ["AVAILABLE", "ABSENT"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "observedAt", "modifiedAt", "sizeBytes", "offset"],
      "properties": {
        "file": {"type": ["string", "null"]},
        "observedAt": {"type": ["string", "null"]},
        "modifiedAt": {"type": ["string", "null"]},
        "sizeBytes": {"type": ["integer", "null"], "minimum": 0},
        "offset": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "events": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["timestamp", "event", "StarSystem", "SystemAddress", "JumpType", "RemainingJumpsInRoute"],
        "properties": {
          "timestamp": {"type": ["string", "null"]},
          "event": {"enum": ["Location", "StartJump", "FSDJump", "FSDTarget"]},
          "StarSystem": {"type": ["string", "null"]},
          "SystemAddress": {"type": ["integer", "null"], "minimum": 1},
          "JumpType": {"type": ["string", "null"]},
          "RemainingJumpsInRoute": {"type": ["integer", "null"], "minimum": 0}
        }
      }
    }
  }
}
