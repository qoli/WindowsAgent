{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "state", "referenceRegion", "physicalRegion", "coordinateSpace", "capturedAt", "highlightRatio", "selectedMinimum", "reason"],
  "properties": {
    "schemaVersion": {"const": 1},
    "state": {"enum": ["NAVIGATION", "NOT_CONFIRMED"]},
    "referenceRegion": {"type": "object"},
    "physicalRegion": {"type": "object"},
    "coordinateSpace": {"type": "object"},
    "capturedAt": {"type": "string", "minLength": 1},
    "highlightRatio": {"type": "number", "minimum": 0, "maximum": 1},
    "selectedMinimum": {"const": 0.75},
    "reason": {"enum": ["NAVIGATION_POINT_CONFIRMED", "NAVIGATION_POINT_NOT_CONFIRMED"]}
  }
}
