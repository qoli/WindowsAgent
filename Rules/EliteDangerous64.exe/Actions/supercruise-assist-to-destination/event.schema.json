{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "payload"],
  "properties": {
    "type": {"const": "action.supercruise-assist-to-destination.update"},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "sample", "targetName", "panelTab", "assistButtonState", "flightStatus", "flightStatusSource", "flightPromptText", "massLock", "landingGear", "cargoScoop", "targetDetected", "targetPresentation", "targetOffsetX", "targetOffsetY", "targetCenterDistancePixels", "assistActiveConfirmations", "assistMissingSamples", "lineOfSightRequiredConfirmations", "lineOfSightRecoveryCount", "lineOfSightControl", "stoppedConfirmations", "commandedThrottle", "lastCommand", "orbitalScaleState", "orbitalScaleConfidence", "humanTakeoverReady", "reason"],
      "properties": {
        "phase": {"enum": ["PREFLIGHT", "OPENING_NAVIGATION", "LOCATING_TARGET", "OPENING_DETAIL", "LOCATING_ASSIST", "FOCUSING_ASSIST", "REQUESTING_ASSIST", "CLOSING_PANEL", "ALIGNING", "CHARGING", "ALIGNING_FOR_ENTRY", "CORRECTING_ASSIST_ALIGNMENT", "VERIFYING_ASSIST_ALIGNMENT", "ENTERED", "WAITING_FOR_ASSIST", "ASSIST_OWNERSHIP_TIMEOUT", "ASSIST_ACTIVE", "CONFIRMING_LINE_OF_SIGHT", "CLEARING_LINE_OF_SIGHT", "REALIGNING_COMPASS_AFTER_SEPARATION", "COMPASS_HANDOFF_CONFIRMED", "REALIGNING_VISIBLE_TARGET_AFTER_SEPARATION", "REALIGNING_AFTER_LINE_OF_SIGHT", "VERIFYING_LINE_OF_SIGHT_CLEAR", "REACQUIRING_ASSIST", "GAME_CONTROLLED_APPROACH", "VERIFYING_STOP", "NEAR_ORBIT_SAFETY_TRIGGERED", "NEAR_ORBIT_AVOIDANCE", "VERIFYING_NEAR_ORBIT_CLEAR", "NEAR_ORBIT_AVOIDANCE_COMPLETED", "NEAR_ORBIT_AVOIDANCE_FAILED", "HUMAN_TAKEOVER", "COMPLETED"]},
        "sample": {"type": "integer", "minimum": 0, "maximum": 5000},
        "targetName": {"type": "string", "minLength": 2, "maxLength": 96},
        "panelTab": {"type": ["string", "null"], "enum": ["ABSENT", "SYSTEM", "NAVIGATION", "TRANSACTIONS", "CONTACTS", "UNKNOWN", null]},
        "assistButtonState": {"type": ["string", "null"], "enum": ["AVAILABLE", "FOCUSED", "ACTIVE", "UNKNOWN", null]},
        "flightStatus": {"enum": ["SUPERCRUISE_ASSIST_ACTIVE", "SUPERCRUISE_ASSIST_LINE_OF_SIGHT_REQUIRED", "SUPERCRUISE", "AUTO_LAUNCH", "WAITING_IN_QUEUE", "SLOW_DOWN_FOR_AUTO_DOCK", "FSD_CHARGING", "FSD_THROTTLE_UP_REQUIRED", "FSD_ALIGNMENT_REQUIRED", "FSD_ESCAPE_VECTOR_REQUIRED", "SAFE_DISENGAGE_READY", "AUTO_DOCK", "UNKNOWN"]},
        "flightStatusSource": {"type": ["string", "null"], "enum": ["PRE_NAVIGATION_SNAPSHOT", "CURRENT_FRAME", null]},
        "flightPromptText": {"type": ["string", "null"], "maxLength": 128},
        "massLock": {"type": ["string", "null"], "enum": ["ON", "OFF", "UNKNOWN", null]},
        "landingGear": {"type": ["string", "null"], "enum": ["ON", "OFF", "UNKNOWN", null]},
        "cargoScoop": {"type": ["string", "null"], "enum": ["ON", "OFF", "UNKNOWN", null]},
        "targetDetected": {"type": ["boolean", "null"]},
        "targetPresentation": {"type": ["string", "null"], "enum": ["SOLID", "HOLLOW", "DASHED", "UNKNOWN", null]},
        "targetOffsetX": {"type": ["integer", "null"]},
        "targetOffsetY": {"type": ["integer", "null"]},
        "targetCenterDistancePixels": {"type": ["number", "null"], "minimum": 0},
        "assistActiveConfirmations": {"type": "integer", "minimum": 0, "maximum": 240},
        "assistMissingSamples": {"type": "integer", "minimum": 0, "maximum": 30},
        "lineOfSightRequiredConfirmations": {"type": "integer", "minimum": 0, "maximum": 2},
        "lineOfSightRecoveryCount": {"type": "integer", "minimum": 0, "maximum": 3},
        "lineOfSightControl": {"type": ["string", "null"], "enum": ["PITCH_UP", "PITCH_DOWN", "YAW_LEFT", "YAW_RIGHT", "PITCH_UP_YAW_LEFT", "PITCH_UP_YAW_RIGHT", "PITCH_DOWN_YAW_LEFT", "PITCH_DOWN_YAW_RIGHT", null]},
        "stoppedConfirmations": {"type": "integer", "minimum": 0, "maximum": 3},
        "commandedThrottle": {"type": ["integer", "null"], "enum": [0, 75, 100, null]},
        "lastCommand": {"type": ["string", "null"], "maxLength": 64},
        "orbitalScaleState": {"type": ["string", "null"], "enum": ["DETECTED", "ABSENT", null]},
        "orbitalScaleConfidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "humanTakeoverReady": {"type": "boolean"},
        "reason": {"type": ["string", "null"], "maxLength": 192}
      }
    }
  }
}
