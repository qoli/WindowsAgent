{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profile", "coordinateSpace", "region", "physicalRegion", "requestDockingRange", "evidence"],
  "properties": {
    "schemaVersion": {"const": 1},
    "profile": {"type": "object"},
    "coordinateSpace": {"type": "object"},
    "region": {"type": "object"},
    "physicalRegion": {"type": "object"},
    "requestDockingRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "allowed", "displayText", "distanceValue", "unit", "distanceMeters", "thresholdMeters", "comparison", "evidence"],
      "properties": {
        "state": {"enum": ["ALLOWED", "DENIED", "UNKNOWN"]},
        "allowed": {"type": ["boolean", "null"]},
        "displayText": {"type": ["string", "null"]},
        "distanceValue": {"type": ["number", "null"], "minimum": 0},
        "unit": {"enum": ["M", "KM", "MM", "LS", "LY", null]},
        "distanceMeters": {"type": ["number", "null"], "minimum": 0},
        "thresholdMeters": {"const": 7500},
        "comparison": {"const": "LT"},
        "evidence": {"type": "object"}
      }
    },
    "evidence": {"type": "object"}
  }
}
