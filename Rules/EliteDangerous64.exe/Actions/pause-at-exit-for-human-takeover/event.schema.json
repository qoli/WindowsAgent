{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["type", "payload"],
  "properties": {
    "type": {"const": "action.pause-at-exit-for-human-takeover.update"},
    "payload": {
      "type": "object", "additionalProperties": false,
      "required": ["phase", "step", "lastCommand", "reason"],
      "properties": {
        "phase": {"enum": ["REPLAYING_PAUSE", "REPLAYING_EXIT_NAVIGATION", "REPLAYING_FIRST_SELECT", "REPLAYING_SECOND_SELECT"]},
        "step": {"type": "integer", "minimum": 1, "maximum": 8},
        "lastCommand": {"enum": ["PAUSE", "DOWN", "SELECT"]},
        "reason": {"type": "string", "minLength": 1, "maxLength": 96}
      }
    }
  }
}
