{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "indicator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "on", "color", "referenceX", "referenceY", "evidence"],
      "properties": {
        "state": {"enum": ["ON", "OFF", "UNKNOWN"]},
        "on": {"type": ["boolean", "null"]},
        "color": {"enum": ["cyan", "orange", null]},
        "referenceX": {"type": ["number", "null"]},
        "referenceY": {"type": ["number", "null"]},
        "evidence": {"type": "object"}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profile", "coordinateSpace", "region", "physicalRegion", "shipStatus", "evidence"],
  "properties": {
    "schemaVersion": {"const": 4},
    "profile": {"type": "object"},
    "coordinateSpace": {"type": "object"},
    "region": {"type": "object"},
    "physicalRegion": {"type": "object"},
    "shipStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["massLock", "landingGear", "cargoScoop"],
      "properties": {
        "massLock": {"$ref": "#/$defs/indicator"},
        "landingGear": {"$ref": "#/$defs/indicator"},
        "cargoScoop": {"$ref": "#/$defs/indicator"}
      }
    },
    "evidence": {"type": "object"}
  }
}
