{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["operation", "stationName"],
  "properties": {
    "operation": {"enum": ["BUY", "SELL"]},
    "stationName": {"type": "string", "minLength": 2, "maxLength": 96, "pattern": "^\\S(?:.*\\S)?$"}
  }
}
