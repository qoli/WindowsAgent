{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profile", "coordinateSpace", "region", "physicalRegion", "speed", "evidence"],
  "properties": {
    "schemaVersion": {"const": 2},
    "profile": {"type": "object"},
    "coordinateSpace": {"type": "object"},
    "region": {"type": "object"},
    "physicalRegion": {"type": "object"},
    "speed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "displayValue", "rawCandidate", "unit", "referencePoints", "evidence"],
      "properties": {
        "state": {"enum": ["STOPPED", "LOW_SPEED", "MOVING", "UNKNOWN"]},
        "displayValue": {"type": ["integer", "null"], "minimum": 0, "maximum": 9999},
        "rawCandidate": {"type": ["integer", "null"], "minimum": 0, "maximum": 9999},
        "unit": {"type": "null"},
        "referencePoints": {"type": ["array", "null"]},
        "evidence": {"type": "object"}
      }
    },
    "evidence": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"speed": {"properties": {"state": {"const": "STOPPED"}}}}},
      "then": {"properties": {"speed": {"properties": {"displayValue": {"const": 0}, "rawCandidate": {"const": 0}}}}}
    },
    {
      "if": {"properties": {"speed": {"properties": {"state": {"const": "LOW_SPEED"}}}}},
      "then": {"properties": {"speed": {"properties": {"displayValue": {"type": "null"}, "rawCandidate": {"type": "integer", "minimum": 1, "maximum": 9}}}}}
    },
    {
      "if": {"properties": {"speed": {"properties": {"state": {"const": "MOVING"}}}}},
      "then": {"properties": {"speed": {"properties": {"displayValue": {"type": "integer", "minimum": 10}, "rawCandidate": {"type": "integer", "minimum": 10}}}}}
    },
    {
      "if": {"properties": {"speed": {"properties": {"state": {"const": "UNKNOWN"}}}}},
      "then": {"properties": {"speed": {"properties": {"displayValue": {"type": "null"}, "rawCandidate": {"type": "null"}}}}}
    }
  ]
}
