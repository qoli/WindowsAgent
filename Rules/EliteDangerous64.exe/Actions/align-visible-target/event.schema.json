{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "payload"],
  "properties": {
    "type": {"const": "action.align-visible-target.update"},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "targetName", "sample", "commandCount", "targetState", "observationMode", "offsetX", "offsetY", "centerDistancePixels", "stableConfirmations", "command", "commandHoldMs", "heatState", "heatPercent", "heatReason", "presentation", "occupiedAngularBins", "angularRuns", "reticleEvidencePlane", "reticleEvidenceQuality", "reticleCapturedAt", "reason", "observationErrorCode", "observationError"],
      "properties": {
        "phase": {"enum": ["STOPPING", "OBSERVING", "ALIGNING", "VERIFYING_CENTER", "COMPLETED", "OBSERVATION_ERROR", "SAFETY_GATE"]},
        "targetName": {"type": "string", "maxLength": 96},
        "sample": {"type": "integer", "minimum": 0, "maximum": 120},
        "commandCount": {"type": "integer", "minimum": 0, "maximum": 80},
        "targetState": {"type": ["string", "null"], "enum": ["DETECTED", "UNKNOWN", null]},
        "observationMode": {"type": ["string", "null"], "enum": ["IDENTITY_ACQUISITION", "RETICLE_TRACKING", "ESCAPE_VECTOR_POSITION", null]},
        "offsetX": {"type": ["number", "null"]},
        "offsetY": {"type": ["number", "null"]},
        "centerDistancePixels": {"type": ["number", "null"], "minimum": 0},
        "stableConfirmations": {"type": "integer", "minimum": 0, "maximum": 120},
        "command": {"type": ["string", "null"], "enum": ["SET_THROTTLE_0", "PITCH_UP", "PITCH_DOWN", "YAW_LEFT", "YAW_RIGHT", null]},
        "commandHoldMs": {"type": ["integer", "null"], "minimum": 40, "maximum": 600},
        "heatState": {"type": ["string", "null"], "enum": ["KNOWN", "UNKNOWN", null]},
        "heatPercent": {"type": ["integer", "null"], "minimum": 0, "maximum": 250},
        "heatReason": {"type": ["string", "null"], "maxLength": 256},
        "presentation": {"type": ["string", "null"], "enum": ["SOLID", "DASHED", null]},
        "occupiedAngularBins": {"type": ["integer", "null"], "minimum": 0, "maximum": 72},
        "angularRuns": {"type": ["integer", "null"], "minimum": 0, "maximum": 36},
        "reticleEvidencePlane": {"type": ["string", "null"], "enum": ["STRICT_RGB", "ORANGE_OPPONENT", "HSV_ORANGE", null]},
        "reticleEvidenceQuality": {"type": ["integer", "null"], "minimum": 0},
        "reticleCapturedAt": {"type": ["string", "null"]},
        "reason": {"type": ["string", "null"], "maxLength": 256},
        "observationErrorCode": {"type": ["string", "null"], "maxLength": 96},
        "observationError": {"type": ["string", "null"], "maxLength": 512}
      }
    }
  }
}
