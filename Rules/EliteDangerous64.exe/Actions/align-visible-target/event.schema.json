{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "payload"],
  "properties": {
    "type": {"const": "action.align-visible-target.update"},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "targetName", "sample", "commandCount", "targetState", "observationMode", "offsetX", "offsetY", "centerDistancePixels", "stableConfirmations", "command", "commandHoldMs", "heatState", "heatPercent", "heatReason", "presentation", "occupiedAngularBins", "angularRuns", "reticleEvidencePlane", "reticleEvidenceQuality", "reticleCapturedAt", "flightStatus", "flightPromptText", "blueZoneConfirmations", "relocalizationState", "relocalizationAttempt", "confirmedHintProfile", "relocalizationHintX", "relocalizationHintY", "reason", "observationErrorCode", "observationError"],
      "properties": {
        "phase": {"enum": ["STOPPING", "OBSERVING", "ALIGNING", "VERIFYING_CENTER", "COMPLETED", "OBSERVATION_ERROR", "SAFETY_GATE", "GAME_ALIGNMENT_GATE"]},
        "targetName": {"type": "string", "maxLength": 96},
        "sample": {"type": "integer", "minimum": 0, "maximum": 192},
        "commandCount": {"type": "integer", "minimum": 0, "maximum": 160},
        "targetState": {"type": ["string", "null"], "enum": ["DETECTED", "UNKNOWN", null]},
        "observationMode": {"type": ["string", "null"], "enum": ["IDENTITY_ACQUISITION", "RETICLE_TRACKING", "RETICLE_RELOCALIZATION", "ESCAPE_VECTOR_POSITION", null]},
        "offsetX": {"type": ["number", "null"]},
        "offsetY": {"type": ["number", "null"]},
        "centerDistancePixels": {"type": ["number", "null"], "minimum": 0},
        "stableConfirmations": {"type": "integer", "minimum": 0, "maximum": 120},
        "command": {"type": ["string", "null"], "enum": ["SET_THROTTLE_0", "PITCH_UP", "PITCH_DOWN", "YAW_LEFT", "YAW_RIGHT", null]},
        "commandHoldMs": {"type": ["integer", "null"], "minimum": 40, "maximum": 600},
        "heatState": {"type": ["string", "null"], "enum": ["KNOWN", "UNKNOWN", null]},
        "heatPercent": {"type": ["integer", "null"], "minimum": 0, "maximum": 250},
        "heatReason": {"type": ["string", "null"], "maxLength": 256},
        "presentation": {"type": ["string", "null"], "enum": ["SOLID", "DASHED", null]},
        "occupiedAngularBins": {"type": ["integer", "null"], "minimum": 0, "maximum": 72},
        "angularRuns": {"type": ["integer", "null"], "minimum": 0, "maximum": 36},
        "reticleEvidencePlane": {"type": ["string", "null"], "enum": ["STRICT_RGB", "ORANGE_OPPONENT", "HSV_ORANGE", null]},
        "reticleEvidenceQuality": {"type": ["integer", "null"], "minimum": 0},
        "reticleCapturedAt": {"type": ["string", "null"]},
        "flightStatus": {"type": ["string", "null"], "enum": ["FSD_THROTTLE_UP_REQUIRED", "SUPERCRUISE_ASSIST_ACTIVE", "SUPERCRUISE_ASSIST_LINE_OF_SIGHT_REQUIRED", "SUPERCRUISE", "FSD_CHARGING", "FSD_ALIGNMENT_REQUIRED", "FSD_ESCAPE_VECTOR_REQUIRED", "SAFE_DISENGAGE_READY", "AUTO_LAUNCH", "WAITING_IN_QUEUE", "SLOW_DOWN_FOR_AUTO_DOCK", "AUTO_DOCK", "UNKNOWN", null]},
        "flightPromptText": {"type": ["string", "null"], "maxLength": 128},
        "blueZoneConfirmations": {"type": "integer", "minimum": 0, "maximum": 2},
        "relocalizationState": {"enum": ["INACTIVE", "TRIGGERED", "CANDIDATE_FOUND", "VALIDATED", "MISS", "CONTRADICTED"]},
        "relocalizationAttempt": {"type": "integer", "minimum": 0, "maximum": 1},
        "confirmedHintProfile": {"enum": ["NONE", "HYPERSPACE_CHARGE", "SUPERCRUISE_ASSIST"]},
        "relocalizationHintX": {"type": ["integer", "null"], "minimum": 70, "maximum": 1850},
        "relocalizationHintY": {"type": ["integer", "null"], "minimum": 70, "maximum": 1010},
        "reason": {"type": ["string", "null"], "maxLength": 256},
        "observationErrorCode": {"type": ["string", "null"], "maxLength": 96},
        "observationError": {"type": ["string", "null"], "maxLength": 512}
      }
    }
  }
}
