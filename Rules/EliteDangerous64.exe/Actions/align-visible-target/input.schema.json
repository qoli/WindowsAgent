{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["targetName"],
  "properties": {
    "targetName": {"type": "string", "minLength": 2, "maxLength": 96},
    "stopBeforeAlign": {"type": "boolean", "default": true},
    "centerHintConfirmed": {"type": "boolean", "default": false},
    "confirmedHintProfile": {"enum": ["NONE", "HYPERSPACE_CHARGE", "SUPERCRUISE_ASSIST"], "default": "NONE"},
    "blueZoneGateEnabled": {"type": "boolean", "default": false},
    "positionSource": {"enum": ["DESTINATION", "ESCAPE_VECTOR"], "default": "DESTINATION"},
    "heatPolicy": {"enum": ["STRICT", "ESCAPE_VECTOR_CHARGE"], "default": "STRICT"}
  }
}
