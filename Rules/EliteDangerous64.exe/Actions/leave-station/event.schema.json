{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "payload"],
  "properties": {
    "type": {"const": "action.leave-station.update"},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "sample", "flightStatus", "flightPromptText", "massLock", "observedSpeedState", "observedSpeedDisplayValue", "commandedThrottle", "instruction", "throttleCommand"],
      "properties": {
        "phase": {"enum": ["AWAITING_AUTO_LAUNCH", "AUTO_LAUNCH_ACTIVE", "DEPARTING", "COMPLETED"]},
        "sample": {"type": "integer", "minimum": 0, "maximum": 2000},
        "flightStatus": {"enum": ["SUPERCRUISE", "AUTO_LAUNCH", "WAITING_IN_QUEUE", "FSD_CHARGING", "FSD_ALIGNMENT_REQUIRED", "AUTO_DOCK", "UNKNOWN"]},
        "flightPromptText": {"type": ["string", "null"], "maxLength": 128},
        "massLock": {"enum": ["ON", "OFF", "UNKNOWN"]},
        "observedSpeedState": {"enum": ["KNOWN", "UNKNOWN"]},
        "observedSpeedDisplayValue": {"type": ["integer", "null"], "minimum": 0, "maximum": 9999},
        "commandedThrottle": {"type": ["integer", "null"], "enum": [0, 100, null]},
        "instruction": {"type": ["string", "null"], "maxLength": 256},
        "throttleCommand": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["schemaVersion", "selection", "control", "key", "activePreset", "bindingFile", "bindingSource", "backend", "scanCode", "extended", "holdMs"],
              "properties": {
                "schemaVersion": {"const": 1},
                "selection": {"enum": ["0", "100"]},
                "control": {"enum": ["SetSpeedZero", "SetSpeed100"]},
                "key": {"type": "string", "pattern": "^Key_[A-Za-z0-9]+$", "maxLength": 32},
                "activePreset": {"type": "string", "minLength": 1, "maxLength": 128},
                "bindingFile": {"type": "string", "pattern": "^[^/\\\\]+\\.binds$", "maxLength": 260},
                "bindingSource": {"const": "frontier-active-preset-v1"},
                "backend": {"const": "sendinput-scancode"},
                "scanCode": {"type": "integer", "minimum": 1, "maximum": 255},
                "extended": {"type": "boolean"},
                "holdMs": {"const": 40}
              }
            }
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"payload": {"properties": {"observedSpeedState": {"const": "KNOWN"}}}}},
      "then": {"properties": {"payload": {"properties": {"observedSpeedDisplayValue": {"type": "integer"}}}}},
      "else": {"properties": {"payload": {"properties": {"observedSpeedDisplayValue": {"type": "null"}}}}}
    }
  ]
}
