{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "task", "completed", "finalPhase", "finalMassLock", "sampleCount"],
  "properties": {
    "schemaVersion": {"const": 1},
    "task": {"const": "LEAVE_STATION"},
    "completed": {"const": true},
    "finalPhase": {"const": "COMPLETED"},
    "finalMassLock": {"const": "OFF"},
    "sampleCount": {"type": "integer", "minimum": 1, "maximum": 2000}
  }
}
