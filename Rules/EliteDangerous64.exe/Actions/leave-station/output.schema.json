{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "task", "completed", "finalPhase", "finalMassLock", "finalCommandedThrottle", "lastObservedSpeedState", "lastObservedSpeedDisplayValue", "sampleCount"],
  "properties": {
    "schemaVersion": {"const": 2},
    "task": {"const": "LEAVE_STATION"},
    "completed": {"const": true},
    "finalPhase": {"const": "COMPLETED"},
    "finalMassLock": {"const": "OFF"},
    "finalCommandedThrottle": {"const": 0},
    "lastObservedSpeedState": {"enum": ["KNOWN", "UNKNOWN"]},
    "lastObservedSpeedDisplayValue": {"type": ["integer", "null"], "minimum": 0, "maximum": 9999},
    "sampleCount": {"type": "integer", "minimum": 1, "maximum": 2000}
  },
  "if": {"properties": {"lastObservedSpeedState": {"const": "KNOWN"}}},
  "then": {"properties": {"lastObservedSpeedDisplayValue": {"type": "integer"}}},
  "else": {"properties": {"lastObservedSpeedDisplayValue": {"type": "null"}}}
}
