{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "task", "completed", "finalPhase", "finalMassLock", "finalCommandedThrottle", "finalStopState", "zeroSpeedConfirmations", "lastObservedSpeedState", "lastObservedSpeedDisplayValue", "lastObservedSpeedRawCandidate", "lastObservedSpeedRawText", "lastObservedSpeedConstrainedText", "lastObservedSpeedConstrainedConfidence", "lastObservedSpeedRawConstraintMargin", "sampleCount"],
  "properties": {
    "schemaVersion": {"const": 3},
    "task": {"const": "LEAVE_STATION"},
    "completed": {"const": true},
    "finalPhase": {"const": "COMPLETED"},
    "finalMassLock": {"const": "OFF"},
    "finalCommandedThrottle": {"const": 0},
    "finalStopState": {"const": "CONFIRMED"},
    "zeroSpeedConfirmations": {"const": 3},
    "lastObservedSpeedState": {"const": "STOPPED"},
    "lastObservedSpeedDisplayValue": {"const": 0},
    "lastObservedSpeedRawCandidate": {"const": 0},
    "lastObservedSpeedRawText": {"const": "0"},
    "lastObservedSpeedConstrainedText": {"const": "0"},
    "lastObservedSpeedConstrainedConfidence": {"type": "number", "minimum": 0.45, "maximum": 1},
    "lastObservedSpeedRawConstraintMargin": {"type": "number", "minimum": 0, "maximum": 0.02},
    "sampleCount": {"type": "integer", "minimum": 1, "maximum": 2000}
  }
}
