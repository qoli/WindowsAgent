{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "payload"],
  "properties": {
    "type": {"const": "action.select-and-lock-destination.update"},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "targetName", "targetState", "observation", "command", "panelCycleCount", "navigationCount", "openedPanel"],
      "properties": {
        "phase": {"enum": ["OPENING_PANEL", "SELECTING_NAVIGATION", "LOCATING_TARGET", "MOVING_FOCUS", "OPENING_DETAIL", "VERIFYING_DETAIL", "SELECTING_LOCK", "VERIFYING_LOCK", "RESTORING_VIEW", "COMPLETED"]},
        "targetName": {"type": "string", "minLength": 2, "maxLength": 96},
        "targetState": {"type": ["string", "null"], "enum": ["LOCKED", "FOCUSED", "VISIBLE", "LOCK", "UNLOCK", "UNKNOWN", null]},
        "observation": {"type": ["object", "null"]},
        "command": {"type": ["string", "null"], "enum": ["FOCUS_LEFT_PANEL", "NEXT_PANEL", "UP", "DOWN", "SELECT", null]},
        "panelCycleCount": {"type": "integer", "minimum": 0, "maximum": 3},
        "navigationCount": {"type": "integer", "minimum": 0, "maximum": 8},
        "openedPanel": {"type": "boolean"}
      }
    }
  }
}
