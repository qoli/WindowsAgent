{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["targetSystem", "targetLockConfirmed", "startMode", "normalSpaceConfirmed", "supercruiseConfirmed"],
  "properties": {
    "targetSystem": {"type": "string", "minLength": 2, "maxLength": 96, "pattern": "^\\S(?:.*\\S)?$"},
    "targetSystemAddress": {"type": ["integer", "null"], "minimum": 1},
    "targetLockConfirmed": {"type": "boolean"},
    "startMode": {"enum": ["NORMAL_SPACE", "SUPERCRUISE"]},
    "normalSpaceConfirmed": {"type": "boolean"},
    "supercruiseConfirmed": {"type": "boolean"}
  },
  "allOf": [
    {"if": {"properties": {"startMode": {"const": "NORMAL_SPACE"}}}, "then": {"properties": {"normalSpaceConfirmed": {"const": true}, "supercruiseConfirmed": {"const": false}}}},
    {"if": {"properties": {"startMode": {"const": "SUPERCRUISE"}}}, "then": {"properties": {"normalSpaceConfirmed": {"const": false}, "supercruiseConfirmed": {"const": true}}}}
  ]
}
