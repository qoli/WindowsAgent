{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "task", "completed", "finalPhase", "destinationSystem", "destinationStation", "routeId", "systemTargetLocked", "stationTargetLocked", "hyperspaceChargingConfirmed", "hyperspaceTransitConfirmed", "cockpitReturnConfirmations", "supercruiseHudConfirmations", "destinationSystemArrivalEvidence", "initialAlignment", "recoveryAlignment", "supercruiseCompleted", "dockingCompleted", "visualConfirmed", "sampleCount"],
  "properties": {
    "schemaVersion": {"const": 1},
    "task": {"const": "INTER_SYSTEM_TRANSIT_TO_STATION"},
    "completed": {"const": true},
    "finalPhase": {"const": "VISUAL_CONFIRMATION_REQUIRED"},
    "destinationSystem": {"type": "string", "minLength": 2, "maxLength": 96},
    "destinationStation": {"type": "string", "minLength": 2, "maxLength": 96},
    "routeId": {"type": "string", "minLength": 5, "maxLength": 256},
    "systemTargetLocked": {"const": true},
    "stationTargetLocked": {"const": true},
    "hyperspaceChargingConfirmed": {"const": true},
    "hyperspaceTransitConfirmed": {"const": true},
    "cockpitReturnConfirmations": {"type": "integer", "minimum": 0},
    "supercruiseHudConfirmations": {"type": "integer", "minimum": 2},
    "destinationSystemArrivalEvidence": {"enum": ["COCKPIT_TRANSITION", "JOURNAL_FSDJUMP", "JOURNAL_FSDJUMP_RESUME"]},
    "initialAlignment": {"type": "object"},
    "recoveryAlignment": {"type": ["object", "null"]},
    "supercruiseCompleted": {"const": true},
    "dockingCompleted": {"const": true},
    "visualConfirmed": {"const": false},
    "sampleCount": {"type": "integer", "minimum": 0}
  }
}
