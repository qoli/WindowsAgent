{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "target", "timing"],
  "properties": {
    "schemaVersion": {"const": 1},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "referenceX", "referenceY", "offsetX", "offsetY", "centerDistancePixels", "reason", "presentation", "occupiedAngularBins", "angularRuns", "reticleEvidencePlane", "reticleEvidenceQuality", "reticleCapturedAt", "rawTexts"],
      "properties": {
        "state": {"enum": ["DETECTED", "UNKNOWN"]},
        "referenceX": {"type": ["number", "null"]},
        "referenceY": {"type": ["number", "null"]},
        "offsetX": {"type": ["number", "null"]},
        "offsetY": {"type": ["number", "null"]},
        "centerDistancePixels": {"type": ["number", "null"], "minimum": 0},
        "reason": {"type": "string"},
        "presentation": {"enum": ["SOLID", "DASHED", null]},
        "occupiedAngularBins": {"type": ["integer", "null"], "minimum": 0, "maximum": 72},
        "angularRuns": {"type": ["integer", "null"], "minimum": 0, "maximum": 36},
        "reticleEvidencePlane": {"enum": ["STRICT_RGB", "ORANGE_OPPONENT", "HSV_ORANGE", null]},
        "reticleEvidenceQuality": {"type": ["integer", "null"], "minimum": 0},
        "reticleCapturedAt": {"type": ["string", "null"]},
        "rawTexts": {"type": "array", "items": {"type": "string"}}
      }
    },
    "timing": {"type": "object"}
  }
}
