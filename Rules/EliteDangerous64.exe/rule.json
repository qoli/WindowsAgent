{
  "schemaVersion": 5,
  "description": "Elite Dangerous exposes finite observation and binding-resolved keyboard Actions plus a supervised leave-station workflow; registrations remain opt-in.",
  "runtimeProfiles": {
    "ocr/w480": {
      "runtime": "ppocr-onnx-dml-worker-v1",
      "residency": "while-rule-active",
      "artifactId": "ppocrv6-small-rec-onnx-official-w480"
    }
  },
  "actions": {
    "elite-dangerous/compass": {
      "path": "Actions/compass",
      "runtime": "windows-observation-v1",
      "execution": {"completion": "return"},
      "registrableAs": ["monitor", "reaction"]
    },
    "elite-dangerous/ship-status": {
      "path": "Actions/ship-status",
      "runtime": "windows-observation-v1",
      "execution": {"completion": "return"},
      "registrableAs": ["monitor", "reaction"]
    },
    "elite-dangerous/flight-prompt-text": {
      "path": "Actions/flight-prompt-text",
      "runtime": "ppocr-w480-text-v1",
      "runtimeProfile": "ocr/w480",
      "execution": {"completion": "return"},
      "registrableAs": ["monitor", "reaction"]
    },
    "elite-dangerous/flight-status": {
      "path": "Actions/flight-status",
      "runtime": "windows-observation-v1",
      "execution": {"completion": "return"},
      "registrableAs": ["monitor", "reaction"]
    },
    "elite-dangerous/ui-control": {
      "path": "Actions/ui-control",
      "runtime": "frontier-key-action-v1",
      "execution": {"completion": "return"},
      "registrableAs": []
    },
    "elite-dangerous/set-throttle": {
      "path": "Actions/set-throttle",
      "runtime": "frontier-key-action-v1",
      "execution": {"completion": "return"},
      "registrableAs": []
    },
    "elite-dangerous/leave-station": {
      "path": "Actions/leave-station",
      "runtime": "windows-streaming-action-v1",
      "execution": {"completion": "stream", "lifecycle": "linear", "interruptible": true},
      "registrableAs": []
    }
  },
  "registrations": {}
}
