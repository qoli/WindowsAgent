{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "save"
  ],
  "properties": {
    "save": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "relative"
      ],
      "properties": {
        "root": {
          "const": "crimson-desert-saves"
        },
        "relative": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "allOf": [
            {
              "pattern": "^[^/\\\\:][^\\\\:]*$"
            },
            {
              "not": {
                "pattern": "(^|/)\\.\\.(/|$)"
              }
            }
          ]
        }
      }
    }
  }
}
